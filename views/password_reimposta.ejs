<%
  // La pagina a cui porta il link dell'email di recupero (GET/POST /reimposta-password/:codice). Stati: 'modulo' (il link è buono: si sceglie la nuova
  // password) e 'nonvalido' (scaduto, già usato o inventato: si può chiederne uno nuovo). Parametri: stato, username, errori ({ nuova, ripeti }).
  const stato = locals.stato || 'modulo';
  const errori = locals.errori || {};
%>
<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo: 'Nuova password' }) %>
  <%# Il codice del link sta nell'indirizzo: la pagina non si tiene in cache né lo passa ad altri siti. %>
  <meta name="referrer" content="no-referrer">
</head>
<body data-loggato="0">
  <main class="acc">
    <header class="acc-testata">
      <span class="acc-icona" aria-hidden="true"><%- iconaLucchetto %></span>
      <div class="acc-occhiello">Ordini Minuteria</div>
      <% if (stato === 'nonvalido') { %>
        <h1 class="acc-titolo">Link non valido</h1>
        <p class="acc-sotto">Questo link è scaduto o è già stato usato. Chiedine uno nuovo: ci vuole un momento.</p>
      <% } else { %>
        <h1 class="acc-titolo">Scegli una nuova password</h1>
        <p class="acc-sotto">Account: <strong><%= username %></strong>. Almeno 8 caratteri. Dopo il cambio dovrai accedere di nuovo, anche sull'app.</p>
      <% } %>
    </header>

    <% if (stato === 'nonvalido') { %>
      <a class="acc-btn acc-btn-link" href="/password-dimenticata">Chiedi un nuovo link</a>
      <p class="acc-fondo"><a href="/login">‹ Torna all'accesso</a></p>
    <% } else { %>
      <% const messaggi = [errori.nuova, errori.ripeti].filter(Boolean); %>
      <% if (messaggi.length) { %><div class="errore" role="alert"><%= messaggi.join(' ') %></div><% } %>
      <form method="POST" action="/reimposta-password/<%= codice %>">
        <%- include('partials/acc_campo', {
          id: 'nuova', etichetta: 'Nuova password', tipo: 'password', sbagliato: !!errori.nuova,
          attributi: { autocomplete: 'new-password', required: true, maxlength: 100 },
        }) %>
        <%- include('partials/acc_campo', {
          id: 'ripeti', etichetta: 'Ripeti la nuova password', tipo: 'password', sbagliato: !!errori.ripeti,
          attributi: { autocomplete: 'new-password', required: true, maxlength: 100 },
        }) %>
        <button class="acc-btn" type="submit">Salva la nuova password</button>
      </form>
    <% } %>
  </main>
  <script src="<%= asset('/app.js') %>" defer></script>
</body>
</html>
