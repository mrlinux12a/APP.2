<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/head', { titolo: 'Ordini in arrivo — Agente' }) %>
</head>
<body>
  <%- include('partials/topbar') %>
  <main>
    <h1>Ordini in arrivo</h1>

    <% if (ordini.length === 0) { %>
      <div class="card">Nessun ordine ricevuto per ora.</div>
    <% } else { %>
      <div class="card">
        <div class="tabella-scroll">
        <table>
          <thead>
            <tr>
              <th>#</th><th>Cliente</th><th>Distributore</th><th>Data</th>
              <th>Modalità</th><th>Imponibile</th><th>Totale</th><th>Stato</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% ordini.forEach(function(o) { %>
              <tr>
                <td>#<%= o.id %></td>
                <td><%= o.cliente_nome %></td>
                <td><%= o.distributore_nome || '—' %></td>
                <td><%= fmt.dataOra(o.creato_il) %></td>
                <td><%= o.modalita === 'ritiro' ? 'Ritiro' : 'Consegna' %></td>
                <td>€ <%= euro(o.totale_finale + o.costo_consegna) %></td>
                <td>€ <%= euro(totaleOrdine(o)) %></td>
                <td><span class="stato-badge stato-<%= o.stato %>"><%= o.stato === 'inviato' ? 'Inviato' : (o.stato === 'in_evasione' ? 'In evasione' : 'Evaso') %></span></td>
                <td><a class="link-secondario" href="/ordini/<%= o.id %>">Dettaglio</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        </div>
      </div>
      <p style="color:#6b7480; font-size:0.85rem;">
        Imponibile e totale sono i valori esposti al cliente (servizio incluso, IVA a parte).
      </p>
    <% } %>
  </main>
</body>
</html>
