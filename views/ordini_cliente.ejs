<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
</head>
<body data-loggato="1">
  <div class="app app-vuoto">
    <%- include('partials/appbar', { titolo, intestazione: 'Stato ordini', indietro: null }) %>

    <%# Nessuna attività in corso (altrimenti /ordini rimanda alla richiesta o all'ordine). Figura, titolo, "Come
        funziona", catalogo e storico: classi vuoto-*, cf-*, riga-storico (blocco "Pagine vuote" di style.css). %>
    <div class="contenuto vuoto-pagina">
      <div class="vuoto-fig" aria-hidden="true">
        <span class="vuoto-fig-tratt"></span>
        <%- iconaFurgone %>
      </div>

      <div class="vuoto-testa">
        <h1 class="vuoto-titolo">Nessun ordine in corso</h1>
        <p class="vuoto-sotto">Quando mandi una richiesta, qui segui ogni passaggio fino al cantiere.</p>
      </div>

      <section class="cf-scheda" aria-labelledby="cf-occhiello">
        <h2 class="cf-occhiello" id="cf-occhiello">Come funziona</h2>
        <ol class="cf-passi" role="list">
          <li class="cf-passo">
            <span class="cf-ico cf-blu" aria-hidden="true"><%- iconaInvio %></span>
            <span class="cf-testi">
              <strong>Mandi la richiesta</strong>
              <span>Scegli i pezzi e paghi dal carrello.</span>
            </span>
          </li>
          <li class="cf-passo">
            <span class="cf-ico cf-arancio" aria-hidden="true"><%- iconaNegozio %></span>
            <span class="cf-testi">
              <strong>Il banco conferma</strong>
              <span>Entro <%= Math.round(minutiRisposta) %> minuti, o ti rimborsiamo.</span>
            </span>
          </li>
          <li class="cf-passo">
            <span class="cf-ico cf-verde" aria-hidden="true"><%- iconaFurgone %></span>
            <span class="cf-testi">
              <strong>Arriva in cantiere</strong>
              <span>Vedi chi lo porta e quanto manca.</span>
            </span>
          </li>
        </ol>
      </section>

      <a class="btn-vuoto-pieno" href="/home"><%- iconaCatalogo %><span>Vai al catalogo</span></a>

      <a class="riga-storico" href="/storico">
        <span class="riga-storico-ico" aria-hidden="true"><%- iconaOrario %></span>
        <span class="riga-storico-testi">
          <strong>Storico ordini</strong>
          <span>Richieste e ordini passati</span>
        </span>
        <span class="riga-storico-freccia" aria-hidden="true">›</span>
      </a>
    </div>
  </div>

  <%- include('partials/nav', { attivo: 'ordini' }) %>
  <script src="<%= asset('/app.js') %>" defer></script>
</body>
</html>
