<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
</head>
<body data-loggato="1">
  <div class="app">
    <%- include('partials/appbar', { titolo, intestazione: 'I miei ordini', indietro: '/home' }) %>

    <div class="contenuto">
      <% if (!ordini.length) { %>
        <div class="vuoto">
          <span class="emoji">📦</span>
          Non hai ancora inviato ordini.
        </div>
        <a class="btn btn-primary btn-blocco" href="/home">Scegli il materiale</a>
      <% } else { %>
        <div class="card card-fitta">
          <% ordini.forEach(function (o) { %>
            <a class="riga-lista" href="/ordini/<%= o.id %>">
              <span class="icona">📦</span>
              <span class="corpo">
                <span class="etichetta">Ordine #<%= o.id %> — € <%= euro(totaleOrdine(o)) %></span>
                <span class="dettaglio">
                  <%= o.distributore_nome || 'Grossista' %> · <%= fmt.dataOra(o.creato_il) %>
                </span>
              </span>
              <span class="stato-badge stato-<%= o.stato %>">
                <%= o.stato === 'inviato' ? 'Inviato' : (o.stato === 'in_evasione' ? 'In preparazione' : 'Partito') %>
              </span>
            </a>
          <% }); %>
        </div>
        <p class="nota">Gli importi mostrati sono IVA inclusa.</p>
      <% } %>
    </div>
  </div>

  <%- include('partials/nav', { attivo: 'ordini' }) %>
  <script src="/app.js" defer></script>
</body>
</html>
