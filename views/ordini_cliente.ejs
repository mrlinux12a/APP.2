<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
</head>
<body data-loggato="1">
  <div class="app">
    <%- include('partials/appbar', { titolo, intestazione: 'Stato ordini', indietro: '/home' }) %>

    <div class="contenuto">
      <div class="sezione-titolo">Richieste in corso</div>
      <% if (!richiesteInCorso.length) { %>
        <div class="card"><p class="nota" style="margin:0;">Nessuna richiesta in attesa. Crea un ordine dal catalogo.</p></div>
      <% } else { %>
        <div class="card card-fitta">
          <% richiesteInCorso.forEach(function (r) { %>
            <a class="riga-lista" href="/richieste/<%= r.id %>">
              <span class="icona"><%= r.stato === 'in_attesa' ? '⏳' : '✅' %></span>
              <span class="corpo">
                <span class="etichetta">Richiesta #<%= r.id %></span>
                <span class="dettaglio"><%= r.stato === 'in_attesa' ? 'In attesa dai distributori' : 'Offerte disponibili' %> · <%= fmt.dataOra(r.creato_il) %></span>
              </span>
              <span class="freccia">›</span>
            </a>
          <% }); %>
        </div>
      <% } %>

      <% if (richiesteStorico.length) { %>
        <details class="altre-categorie" style="margin-top:12px;">
          <summary>Storico richieste</summary>
          <div class="card card-fitta">
            <% richiesteStorico.forEach(function (r) { %>
              <a class="riga-lista" href="/richieste/<%= r.id %>">
                <span class="icona">📄</span>
                <span class="corpo">
                  <span class="etichetta">Richiesta #<%= r.id %></span>
                  <span class="dettaglio"><%= r.stato %> · <%= fmt.dataOra(r.creato_il) %></span>
                </span>
                <span class="freccia">›</span>
              </a>
            <% }); %>
          </div>
        </details>
      <% } %>

      <div class="sezione-titolo" style="margin-top:18px;">Ordini confermati</div>
      <% if (!ordini.length) { %>
        <div class="vuoto">
          <span class="emoji">📦</span>
          Non hai ancora ordini confermati.
        </div>
      <% } else { %>
        <div class="card card-fitta">
          <% ordini.forEach(function (o) { %>
            <a class="riga-lista" href="/ordini/<%= o.id %>">
              <span class="icona">📦</span>
              <span class="corpo">
                <span class="etichetta">Ordine #<%= o.id %> — € <%= euro(totaleOrdine(o)) %></span>
                <span class="dettaglio">
                  <%= o.distributore_nome || 'Grossista' %> · <%= fmt.dataOra(o.creato_il) %>
                </span>
              </span>
              <span class="stato-badge stato-<%= o.stato %>">
                <%= o.stato === 'inviato' ? 'Inviato' : (o.stato === 'in_evasione' ? 'In preparazione' : 'Partito') %>
              </span>
            </a>
          <% }); %>
        </div>
        <p class="nota">Gli importi sono IVA inclusa. Tocca un ordine per dettagli e bolla.</p>
      <% } %>
    </div>
  </div>

  <%- include('partials/nav', { attivo: 'ordini' }) %>
  <script src="/app.js" defer></script>
</body>
</html>
