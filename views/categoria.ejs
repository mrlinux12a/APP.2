<%
  function conFiltri(cambio) {
    const stato = { sotto: sottoSlug, misura, marchio };
    Object.keys(cambio).forEach(function (k) { stato[k] = cambio[k]; });
    const parti = Object.keys(stato)
      .filter(function (k) { return stato[k]; })
      .map(function (k) { return k + '=' + encodeURIComponent(stato[k]); });
    return '/categoria/' + macro.slug + (parti.length ? '?' + parti.join('&') : '');
  }
%>
<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
</head>
<body data-loggato="1">
  <div class="app app-categoria<%= elenco ? '' : ' app-sotto' %>">
    <%- include('partials/appbar', {
          titolo,
          indietro: sottoSlug || q ? '/categoria/' + macro.slug : '/home'
        }) %>

    <%# Elenco delle sottocategorie: la ricerca resta fissa sotto l'intestazione (sticky funziona solo se il
        blocco è figlio diretto di .app, che è alto quanto la pagina). %>
    <div class="contenuto<%= elenco ? '' : ' ricerca-fissa-sotto' %>"<%- elenco ? ' style="padding-bottom:0;"' : '' %>>
      <%- include('partials/barra_ricerca', {
            azione: '/categoria/' + macro.slug,
            q,
            ambito: { macro: macro.slug, sotto: sottoSlug || '' },
            segnaposto: sotto ? 'Cerca in ' + sotto.nome : 'Cerca in ' + macro.nome
          }) %>
    </div>

    <% if (!elenco) { %>
      <% if (macro.descrizione) { %>
        <div class="contenuto" style="padding-top:0;">
          <p class="sottotitolo"><%= macro.descrizione %></p>
        </div>
      <% } %>
      <% if (!sottocategorie.length) { %>
        <div class="contenuto" style="padding-top:0;">
          <div class="vuoto"><span class="emoji"><%- iconaVuotoScatola %></span>Nessun prodotto in questa categoria.</div>
        </div>
      <% } else { %>
        <%# Foto in src/catalogo.js (s.foto): c'è solo se il file esiste. Senza foto, o se non si carica
            (onerror toglie l'<img>), resta il riquadro grigio con l'icona della categoria madre. %>
        <div class="griglia-sotto">
          <% sottocategorie.forEach(function (s) { %>
            <a class="sotto-scheda" href="<%= conFiltri({ sotto: s.slug, misura: null, marchio: null }) %>">
              <span class="sotto-foto">
                <span class="sotto-segnaposto"><%- iconaCategoria(macro.slug) %></span>
                <% if (s.foto) { %>
                  <img src="<%= s.foto %>" alt="<%= s.nome %>" width="600" height="450" loading="lazy"
                       onerror="this.remove()">
                <% } %>
              </span>
              <span class="sotto-nome"><span class="sotto-testo"><%= s.nome %></span></span>
            </a>
          <% }); %>
        </div>
      <% } %>

    <% } else { %>
      <div class="contenuto" style="padding-top:0;">

        <% if (!q && marchi.length > 1) { %>
          <div class="filtro-titolo">Marchio <span class="secondario">(facoltativo)</span></div>
          <div class="chip-riga">
            <a class="chip <%= marchio ? '' : 'attivo' %>" href="<%= conFiltri({ marchio: null }) %>">Tutti</a>
            <% marchi.forEach(function (b) { %>
              <a class="chip <%= marchio === b.slug ? 'attivo' : '' %>"
                 href="<%= conFiltri({ marchio: b.slug }) %>"><%= b.nome %> · <%= b.n %></a>
            <% }); %>
          </div>
        <% } %>

        <% if (elenco.ricerca) { %>
          <p class="sottotitolo"><strong><%= elenco.righe.length %></strong> risultati per «<%= q %>»</p>
        <% } %>

        <%# data-righe-compatte: app.js disegna qui le righe compatte (ricerca live, scroll infinito) e tiene
            le quantità del carrello dai dati sotto: carrello com'è ora, pezzi totali, icona del riquadro senza foto. %>
        <div id="risultati" data-righe-compatte
             data-carrello="<%= JSON.stringify(carrello || {}) %>"
             data-pezzi="<%= carrelloPezzi || 0 %>"
             data-icona-vuota="<%= iconaOrdini %>">
          <% if (!elenco.righe.length) { %>
            <div class="vuoto"><span class="emoji"><%- iconaVuotoRicerca %></span>Nessun articolo con questi filtri.</div>
          <% } else { %>
            <div class="card card-fitta elenco-righe">
              <% elenco.righe.forEach(function (p) { %>
                <%- include('partials/prodotto_riga', { p, carrello }) %>
              <% }); %>
            </div>
          <% } %>
        </div>

        <% if (!elenco.ricerca) { %>
          <div data-paginazione>
            <%- include('partials/paginazione', { elenco, base: conFiltri({}) + (conFiltri({}).indexOf('?') === -1 ? '?' : '') }) %>
          </div>
          <%
            const parametriApi = [];
            if (sottoSlug) parametriApi.push('sotto=' + encodeURIComponent(sottoSlug));
            if (misura) parametriApi.push('misura=' + encodeURIComponent(misura));
            if (marchio) parametriApi.push('marchio=' + encodeURIComponent(marchio));
          %>
          <div hidden
               data-scroll-infinito
               data-pagina="<%= elenco.pagina %>"
               data-pagine="<%= elenco.pagine %>"
               data-url="/api/categoria/<%= macro.slug %>/prodotti<%= parametriApi.length ? '?' + parametriApi.join('&') : '' %>"></div>
        <% } %>

        <p class="nota">
          Prezzi IVA esclusa. La disponibilità la chiedi al banco dal riepilogo, dopo Procedi.
        </p>
      </div>

      <!-- Barra sopra la navbar: pezzi nel carrello e "Vai al carrello"; compare solo con almeno un pezzo -->
      <div class="barra-vai" data-barra-vai <%= carrelloPezzi ? '' : 'hidden' %>>
        <a class="barra-vai-link" href="/carrello">
          <span class="bv-pezzi" data-barra-pezzi><%= carrelloPezzi || 0 %> <%= carrelloPezzi === 1 ? 'pezzo' : 'pezzi' %></span>
          <span class="bv-pillola">Vai al carrello <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
      </div>
    <% } %>
  </div>

  <%- include('partials/nav', { attivo: 'catalogo' }) %>
  <script src="<%= asset('/app.js') %>" defer></script>
</body>
</html>
