<%
  function conFiltri(cambio) {
    const stato = { sotto: sottoSlug, misura, marchio };
    Object.keys(cambio).forEach(function (k) { stato[k] = cambio[k]; });
    const parti = Object.keys(stato)
      .filter(function (k) { return stato[k]; })
      .map(function (k) { return k + '=' + encodeURIComponent(stato[k]); });
    return '/categoria/' + macro.slug + (parti.length ? '?' + parti.join('&') : '');
  }
%>
<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
</head>
<body data-loggato="1">
  <div class="app">
    <%- include('partials/appbar', {
          titolo,
          indietro: sottoSlug || q ? '/categoria/' + macro.slug : '/home'
        }) %>

    <div class="contenuto" style="padding-bottom:0;">
      <%- include('partials/barra_ricerca', {
            azione: '/categoria/' + macro.slug,
            q,
            ambito: { macro: macro.slug, sotto: sottoSlug || '' },
            segnaposto: sotto ? 'Cerca in ' + sotto.nome : 'Cerca in ' + macro.nome
          }) %>
    </div>

    <% if (!elenco) { %>
      <div class="contenuto" style="padding-top:0;">
        <p class="sottotitolo"><%= macro.descrizione %></p>
        <% if (!sottocategorie.length) { %>
          <div class="vuoto"><span class="emoji">📭</span>Nessun prodotto in questa categoria.</div>
        <% } else { %>
          <div class="card card-fitta">
            <% sottocategorie.forEach(function (s) { %>
              <a class="riga-lista" href="<%= conFiltri({ sotto: s.slug, misura: null, marchio: null }) %>">
                <span class="icona">📁</span>
                <span class="corpo">
                  <span class="etichetta"><%= s.nome %></span>
                  <span class="dettaglio"><%= s.n %> articoli</span>
                </span>
                <span class="freccia">›</span>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>

    <% } else { %>
      <div class="contenuto" style="padding-top:0;">

        <% if (!q && misure.length) { %>
          <div class="filtro-titolo">Misura</div>
          <div class="chip-riga">
            <a class="chip <%= misura ? '' : 'attivo' %>" href="<%= conFiltri({ misura: null }) %>">Tutte</a>
            <% misure.forEach(function (m) { %>
              <a class="chip <%= misura === m.misura ? 'attivo' : '' %>"
                 href="<%= conFiltri({ misura: m.misura }) %>"><%= m.misura %></a>
            <% }); %>
          </div>
        <% } %>

        <% if (!q && marchi.length > 1) { %>
          <div class="filtro-titolo">Marchio <span class="secondario">(facoltativo)</span></div>
          <div class="chip-riga">
            <a class="chip <%= marchio ? '' : 'attivo' %>" href="<%= conFiltri({ marchio: null }) %>">Tutti</a>
            <% marchi.forEach(function (b) { %>
              <a class="chip <%= marchio === b.slug ? 'attivo' : '' %>"
                 href="<%= conFiltri({ marchio: b.slug }) %>"><%= b.nome %> · <%= b.n %></a>
            <% }); %>
          </div>
        <% } %>

        <p class="sottotitolo">
          <% if (elenco.ricerca) { %>
            <strong><%= elenco.righe.length %></strong> risultati per «<%= q %>»
          <% } else { %>
            <strong><%= sotto ? sotto.nome : macro.nome %></strong> — <%= elenco.totale %> articoli
          <% } %>
        </p>

        <div id="risultati">
          <% if (!elenco.righe.length) { %>
            <div class="vuoto"><span class="emoji">🤷</span>Nessun articolo con questi filtri.</div>
          <% } else { %>
            <div class="card card-fitta">
              <% elenco.righe.forEach(function (p) { %>
                <%- include('partials/prodotto', { p, carrello }) %>
              <% }); %>
            </div>
          <% } %>
        </div>

        <% if (!elenco.ricerca) { %>
          <div data-paginazione>
            <%- include('partials/paginazione', { elenco, base: conFiltri({}) + (conFiltri({}).indexOf('?') === -1 ? '?' : '') }) %>
          </div>
        <% } %>

        <p class="nota">
          Prezzi IVA esclusa. La disponibilità la chiedi al banco dal riepilogo, dopo Procedi.
        </p>
      </div>

      <!-- Barra carrello: Aggiungi globale + Vai al carrello -->
      <div class="barra-carrello" data-barra-carrello <%= carrelloPezzi ? '' : 'hidden' %>>
        <div class="interno">
          <div class="barra-carrello-testo">
            <span data-pendenti-wrap hidden><strong data-pendenti>0</strong> selezionati</span>
            <span data-sep-pendenti hidden> · </span>
            <span data-carrello-wrap <%= carrelloPezzi ? '' : 'hidden' %>><strong data-carrello-conta><%= carrelloPezzi %></strong> nel carrello</span>
            <span data-carrello-vuoto <%= carrelloPezzi ? 'hidden' : '' %>>Nessun pezzo nel carrello</span>
          </div>
          <div style="display:flex;gap:8px;align-items:center;">
            <button class="btn btn-primary" type="button" data-aggiungi-tutti disabled>Aggiungi</button>
            <a class="btn btn-chiaro" href="/carrello" data-vai-carrello <%= carrelloPezzi ? '' : 'hidden' %>>Vai al carrello</a>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <%- include('partials/nav', { attivo: sottoSlug ? '' : 'home' }) %>
  <script src="/app.js" defer></script>
</body>
</html>
