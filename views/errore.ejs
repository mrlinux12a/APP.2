<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
</head>
<body data-loggato="<%= currentUser ? '1' : '0' %>">
  <div class="app">
    <%- include('partials/appbar', { titolo, indietro: '/' }) %>
    <div class="contenuto">
      <div class="errore"><%= messaggio %></div>
      <a class="btn btn-primary btn-blocco" href="<%= typeof link !== 'undefined' && link ? link : '/' %>">
        <%= typeof linkTesto !== 'undefined' && linkTesto ? linkTesto : 'Torna indietro' %>
      </a>
    </div>
  </div>
  <script src="/app.js" defer></script>
</body>
</html>
