<% const str = (typeof striscia !== 'undefined' && striscia) ? striscia : null; %>
<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
</head>
<body data-loggato="1"<%- str ? ' class="con-striscia"' : '' %>>
  <%
    // Ordine consegnato, visto dal cliente: pagina in verde con scheda di stato, "Riordina", materiale e costi (vedi il
    // ramo più sotto). Banco e agente vedono ancora la scheda di sempre.
    const consegnato = currentUser.ruolo === 'cliente' && !!ordine.consegnato_il;
  %>
  <div class="app<%= currentUser.ruolo === 'cliente' ? (consegnato ? ' app-consegnato' : '') : ' app-largo' %>">
    <%- include('partials/appbar', {
          titolo,
          intestazione: str ? 'Stato ordini' : (currentUser.ruolo === 'cliente' ? 'Ordine' : 'Ordine #' + ordine.id),
          indietro: str ? null : (currentUser.ruolo === 'agente' ? '/agente/ordini' : (currentUser.ruolo === 'distributore' ? '/distributore' : '/home'))
        }) %>
    <% if (str) { %><%- include('partials/striscia_ordini', { striscia: str }) %><% } %>

    <div class="contenuto">
      <%
        // "In consegna" = ordine del cliente non ancora consegnato (la modalità "ritiro" è del vecchio flusso).
        // Consegnato e ritiro, e le viste di banco e agente, restano com'erano.
        const inConsegna = currentUser.ruolo === 'cliente' && !ordine.consegnato_il && ordine.modalita !== 'ritiro';
      %>
      <% if (nuovo && currentUser.ruolo === 'cliente' && !inConsegna && !consegnato) { %>
        <div class="avviso avviso-ok">
          <strong>Ordine confermato.</strong> Il distributore prepara il materiale.
          <%= ordine.corriere_arrivo_il
              ? 'Consegna prevista entro le ' + fmt.oraRoma(ordine.corriere_arrivo_il) + '.'
              : (ordine.consegna_ore ? 'Arriva entro ' + fmt.tempoConsegna(ordine.consegna_ore) + '.' : '') %>
        </div>
      <% } %>

      <% if (inConsegna) { %>
        <%
          // Anello e barra "In consegna": l'anello parte pieno quando l'ordine nasce (conferma del banco) e si
          // svuota fino a zero all'ora d'arrivo; la barra si riempie in proporzione al tempo trascorso. Li muove
          // lo script "Consegna in arrivo" di app.js, ogni secondo e in modo lineare, dai due numeri sul riquadro
          // ([data-eta-sec] = secondi all'arrivo, [data-eta-durata] = durata totale).
          // creato_il è un TIMESTAMP UTC senza fuso (istanteUtc lo rimette a posto); corriere_arrivo_il è già un
          // istante vero. Senza orario d'arrivo (né corriere né ore stimate) l'anello resta pieno e fermo.
          const creatoIl = fmt.istanteUtc(ordine.creato_il);
          const arrivoIl = ordine.corriere_arrivo_il
            ? fmt.toDate(ordine.corriere_arrivo_il)
            : (creatoIl && ordine.consegna_ore != null ? new Date(creatoIl.getTime() + ordine.consegna_ore * 3600 * 1000) : null);
          const durataSec = creatoIl && arrivoIl ? Math.max(1, Math.round((arrivoIl - creatoIl) / 1000)) : 0;
          const rimanenteSec = arrivoIl ? Math.round((arrivoIl - Date.now()) / 1000) : 0;
          const frazioneRimasta = durataSec ? Math.min(1, Math.max(0, rimanenteSec / durataSec)) : 1;
          const CIRC_CONSEGNA = 402.12; // 2 * PI * 64
          // Negli ultimi 3 minuti ("In arrivo") l'anello ricomincia da vuoto e si riempie fino all'arrivo (cronometro): lo fa anche lo script.
          const offsetConsegna = (arrivoIl && fmt.inArrivo(rimanenteSec)
            ? CIRC_CONSEGNA * Math.max(0, rimanenteSec) / fmt.SOGLIA_IN_ARRIVO_SEC
            : CIRC_CONSEGNA * (1 - frazioneRimasta)).toFixed(2);
          const percTrascorsa = durataSec ? ((1 - frazioneRimasta) * 100).toFixed(1) : 50;
          // Titolo = tempo stimato; a 3 minuti o meno dall'arrivo (o a orario passato) solo "In arrivo". Con l'orario d'arrivo il titolo
          // normale sta anche in data-eta-testo: lo script torna a scriverlo o passa a "In arrivo" da solo, senza ricaricare.
          const titoloNormale = ordine.corriere_arrivo_il
            ? 'Arriva entro le ' + fmt.oraRoma(ordine.corriere_arrivo_il)
            : (ordine.consegna_ore ? 'Arriva entro ' + fmt.tempoConsegna(ordine.consegna_ore) : 'Tempi di consegna da confermare');
          const titoloConsegna = arrivoIl && fmt.inArrivo(rimanenteSec) ? 'In arrivo' : titoloNormale;
          // Chi porta la merce: il corriere se c'è, altrimenti il banco (consegna con il suo mezzo).
          const portatoDa = (ordine.corriere_nome || '').trim() || (distributore ? distributore.nome : '');
          const spunta = '<span class="att-spunta" aria-hidden="true"><svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>';
        %>

        <%# 1. Stato: anello che si svuota, passaggi (NON si tocca) %>
        <div class="card att-card att-timer att-verde"<% if (arrivoIl) { %> data-eta-sec="<%= rimanenteSec %>"<% if (durataSec) { %> data-eta-durata="<%= durataSec %>"<% } } %>>
          <div class="att-anello">
            <svg viewBox="0 0 148 148" aria-hidden="true">
              <circle class="traccia" cx="74" cy="74" r="64"/>
              <circle class="avanzamento"<%- arrivoIl && durataSec ? ' data-eta-arco' : '' %> data-circ="<%= CIRC_CONSEGNA %>" cx="74" cy="74" r="64" style="stroke-dashoffset: <%= offsetConsegna %>"/>
            </svg>
            <span class="att-furgone" aria-hidden="true"><span><%- iconaFurgone %></span></span>
          </div>
          <h2 class="att-titolo<%= portatoDa ? '' : ' att-titolo-solo' %>"><span class="att-punto" aria-hidden="true"></span><% if (arrivoIl) { %><span data-eta-testo="<%= titoloNormale %>"><%= titoloConsegna %></span><% } else { %><%= titoloConsegna %><% } %></h2>
          <% if (portatoDa) { %><p class="att-sotto">Te lo porta <strong><%= portatoDa %></strong></p><% } %>
          <ol class="att-passi">
            <li class="att-passo att-fatto">
              <span class="att-barretta"></span>
              <span class="att-etichetta"><%- spunta %>Inviata</span>
            </li>
            <li class="att-passo att-fatto">
              <span class="att-barretta"></span>
              <span class="att-etichetta"><%- spunta %>Confermata</span>
            </li>
            <li class="att-passo att-corrente" aria-current="step">
              <span class="att-barretta"><span class="att-riempimento"<%- arrivoIl && durataSec ? ' data-eta-barra' : '' %> style="width: <%= percTrascorsa %>%"></span></span>
              <span class="att-etichetta">In consegna</span>
            </li>
          </ol>
        </div>

        <%# 2. Banco %>
        <% if (distributore) { %>
          <div class="card att-card att-banco">
            <span class="att-icona" aria-hidden="true"><%- iconaNegozio %></span>
            <div class="att-banco-testo">
              <div class="att-occhiello">Materiale da</div>
              <div class="att-banco-nome"><%= distributore.nome %></div>
            </div>
            <span class="att-chip-ok"><%- spunta %>Confermato</span>
          </div>
        <% } %>

        <%# 3. Materiale in arrivo: righe a PREZZO DEL BANCO, "Merce · IVA esclusa" e, se c'è, il DDT. Niente più consegna, IVA e totale qui:
            stanno in "Pagamenti". %>
        <div class="card att-card att-materiale">
          <div class="att-occhiello">Materiale in arrivo</div>
          <%- include('partials/ordine_righe', { righe, importi, ordine }) %>
        </div>

        <%# 4. Pagamenti: la consegna (pagata in app) e il materiale (da pagare a BOREA), divisi come nel carrello, mai sommati. %>
        <%- include('partials/pagamenti', { importi, stato: 'ordine', ditta: fmt.nomeCommerciale(distributore ? distributore.nome : ''), statoPag, ordineId: ordine.id }) %>

        <%# "Consegnato": si segna da qui, non dalla home. Con l'ordine evaso vale la rotta vera (/consegnato); negli
            altri stati la rotta PROVVISORIA (/consegnato-prova, vale per qualunque stato), da togliere quando la
            consegna verrà segnata da un evento vero. Entrambe riportano in "Stato ordini" (/ordini). %>
        <% if (ordine.stato === 'evaso') { %>
          <form method="POST" action="/ordini/<%= ordine.id %>/consegnato">
            <button class="btn btn-primary btn-blocco" type="submit">Ho ricevuto il materiale</button>
          </form>
        <% } else { %>
          <form method="POST" action="/ordini/<%= ordine.id %>/consegnato-prova">
            <button class="btn btn-primary btn-blocco" type="submit" title="Provvisorio: segna l'ordine come consegnato">Ho ricevuto il materiale</button>
          </form>
        <% } %>

        <%# Niente "Annulla ordine": il banco ha già confermato e la carta è stata incassata, quindi l'ordine non si annulla più (la rotta lo rifiuta
            comunque). Per un problema si contatta l'assistenza. %>

      <% } else if (consegnato) { %>
        <%
          // Ordine consegnato (cliente): stessa struttura di "Ordine in consegna", in verde e senza animazioni. Il
          // riquadro verde con "Consegnato il ..." e il nome del banco non c'è più: i dati stanno nelle schede.
          // consegnato_il è un TIMESTAMP UTC senza fuso: dataEstesaRoma / dataOraRoma lo mostrano in ora italiana.
          const spunta = '<span class="att-spunta" aria-hidden="true"><svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>';
        %>

        <%# 1. Stato: ordine chiuso, niente anello che si svuota. Tutti e tre i passaggi sono completati. %>
        <div class="card att-card att-timer att-verde att-consegnato">
          <div class="att-esito" aria-hidden="true">
            <span><svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 12.5l4.2 4.2L18.5 8"/></svg></span>
          </div>
          <h2 class="att-titolo">Consegnato</h2>
          <p class="att-sotto"><%= fmt.dataEstesaRoma(ordine.consegnato_il) %></p>
          <ol class="att-passi">
            <li class="att-passo att-fatto">
              <span class="att-barretta"></span>
              <span class="att-etichetta"><%- spunta %>Inviata</span>
            </li>
            <li class="att-passo att-fatto">
              <span class="att-barretta"></span>
              <span class="att-etichetta"><%- spunta %>Confermata</span>
            </li>
            <li class="att-passo att-fatto">
              <span class="att-barretta"></span>
              <span class="att-etichetta"><%- spunta %>Consegnata</span>
            </li>
          </ol>
        </div>

        <%# 2. Riordina: lo stesso POST di "Riordina" dello storico (somma al carrello, salta gli articoli non più disponibili, torna a /carrello con l'avviso). %>
        <form class="att-riordina" method="POST" action="/storico/<%= ordine.id %>/riordina">
          <button class="att-rinvia" type="submit"><%- iconaRiprova %><span>Riordina gli stessi pezzi</span></button>
        </form>

        <%# 3. Banco e materiale in una sola scheda: righe a PREZZO DEL BANCO, "Merce · IVA esclusa" e il DDT (se c'è). %>
        <div class="card att-card att-ordine">
          <div class="att-ordine-testa">
            <% if (distributore) { %>
              <span class="att-icona" aria-hidden="true"><%- iconaNegozio %></span>
              <div class="att-banco-testo">
                <div class="att-occhiello">Materiale consegnato</div>
                <div class="att-banco-nome"><%= distributore.nome %></div>
              </div>
            <% } else { %>
              <div class="att-banco-testo"><div class="att-occhiello">Materiale consegnato</div></div>
            <% } %>
            <span class="att-ordine-id">Ordine #<%= ordine.id %></span>
          </div>
          <%- include('partials/ordine_righe', { righe, importi, ordine }) %>
        </div>

        <%# 4. Pagamenti: stessa scheda dell'ordine in consegna (la consegna pagata in app, il materiale da pagare a BOREA). %>
        <%- include('partials/pagamenti', { importi, stato: 'consegnato', ditta: fmt.nomeCommerciale(distributore ? distributore.nome : ''), statoPag, ordineId: ordine.id }) %>

        <%# Niente "Annulla ordine": un ordine consegnato non si annulla (e la rotta lo rifiuta). %>

      <% } else if (currentUser.ruolo === 'cliente') { %>
        <%
          const statoLabel = ordine.consegnato_il ? 'Consegnato' : (ordine.stato === 'inviato' ? 'Inviato' : (ordine.stato === 'in_evasione' ? 'In preparazione' : 'In consegna'));
          const tempoTesto = ordine.consegnato_il
            ? 'Consegnato il ' + fmt.dataOra(ordine.consegnato_il)
            : (ordine.modalita === 'ritiro'
                ? 'Pronto per il ritiro al banco'
                : (ordine.corriere_arrivo_il
                    ? 'Consegna prevista entro le ' + fmt.oraRoma(ordine.corriere_arrivo_il)
                    : (ordine.consegna_ore ? 'Arriva entro ' + fmt.tempoConsegna(ordine.consegna_ore) : 'Tempi di consegna da confermare')));
        %>
        <div class="ordine-hero verde">
          <span class="badge"><%= statoLabel %></span>
          <div class="tempo"><%= tempoTesto %></div>
          <% if (distributore) { %>
            <div class="sotto"><%= distributore.nome %><% if (distributore.filiale) { %> · <%= distributore.filiale %><% } %></div>
          <% } %>
        </div>

        <%# Ordine a ritiro (vecchio flusso), visto dal cliente: stessa divisione del carrello nuovo. Righe a PREZZO DEL BANCO e "Merce · IVA esclusa";
            consegna e materiale in "Pagamenti" (senza pagamento registrato la consegna non dice "pagata"). %>
        <div class="sezione-titolo">Materiale</div>
        <div class="card">
          <% righe.forEach(function (r) { %>
            <div class="riga-articolo">
              <div class="qta"><%= r.quantita %>×</div>
              <div class="desc">
                <%= r.nome_snapshot %>
                <div class="meta">Cod. <%= r.codice_snapshot %> · € <%= euro(Number(r.prezzo_netto_unitario) + Number(r.raee_unitario || 0)) %> cad.</div>
              </div>
              <div class="imp">€ <%= euro(Number(r.subtotale) + Number(r.raee_riga || 0)) %></div>
            </div>
          <% }); %>
          <div class="riepilogo-riga">
            <span class="voce">Merce · IVA esclusa</span>
            <span>€ <%= euro(importi.banco.imponibile) %></span>
          </div>
        </div>

        <%- include('partials/pagamenti', { importi, stato: 'ordine', ditta: fmt.nomeCommerciale(distributore ? distributore.nome : ''), statoPag, ordineId: ordine.id }) %>

        <details class="altre-categorie">
          <summary>Dettagli consegna e documenti</summary>
          <div class="card card-fitta">
            <% if (distributore) { %>
              <div class="riga-lista">
                <span class="icona"><%- iconaNegozio %></span>
                <span class="corpo">
                  <span class="etichetta"><%= distributore.nome %></span>
                  <span class="dettaglio"><%= distributore.filiale %></span>
                </span>
              </div>
            <% } %>
            <div class="riga-lista">
              <span class="icona"><%- iconaConsegna %></span>
              <span class="corpo">
                <span class="etichetta">
                  <%= ordine.modalita === 'ritiro' ? 'Ritiro al banco' : 'Consegna con mezzo del distributore' %>
                </span>
                <span class="dettaglio">
                  <% if (ordine.corriere_arrivo_il) { %>Consegna con corriere, prevista entro le <%= fmt.oraRoma(ordine.corriere_arrivo_il) %>
                  <% } else { %>
                  <% if (ordine.partenza_ore) { %>Partenza stimata: <%= fmt.tempoConsegna(ordine.partenza_ore) %> · <% } %>
                  <%= ordine.consegna_ore ? 'consegna stimata: ' + fmt.tempoConsegna(ordine.consegna_ore) : 'tempo da concordare' %>
                  <% } %>
                </span>
              </span>
            </div>
            <% if (ordine.destinazione) { %>
              <div class="riga-lista">
                <span class="icona"><%- iconaDestinazione %></span>
                <span class="corpo">
                  <span class="etichetta">Destinazione merce</span>
                  <span class="dettaglio"><%= ordine.destinazione %></span>
                </span>
              </div>
            <% } %>
            <% if (ordine.ddt_numero) { %>
              <a class="riga-lista" href="/ddt/<%= ordine.id %>">
                <span class="icona"><%- iconaFiscale %></span>
                <span class="corpo">
                  <span class="etichetta">Bolla / DDT n. <%= ordine.ddt_numero %></span>
                  <span class="dettaglio">Del <%= fmt.dataSola(ordine.ddt_data) %></span>
                </span>
                <span class="freccia">›</span>
              </a>
            <% } %>
            <% if (ordine.note) { %>
              <div class="riga-lista">
                <span class="icona"><%- iconaNota %></span>
                <span class="corpo">
                  <span class="etichetta">Note</span>
                  <span class="dettaglio"><%= ordine.note %></span>
                </span>
              </div>
            <% } %>
          </div>
        </details>

        <% if (ordine.stato === 'evaso' && !ordine.consegnato_il) { %>
          <form method="POST" action="/ordini/<%= ordine.id %>/consegnato">
            <button class="btn btn-primary btn-blocco" type="submit">Ho ricevuto il materiale</button>
          </form>
        <% } %>

      <% } else { %>
        <%# Vista di BANCO e AGENTE: NON cambia (stesso markup di prima). Mostra i valori salvati in order_items col prezzo del cliente
            (subtotale_cliente, col 10% di servizio) e totale_finale/totale_ivato: non la divisione "consegna pagata in app / materiale da
            pagare a BOREA" dell'installatore. Il materiale del cliente per il banco sta nella pagina del cliente (src/materiale.js). %>
        <div class="card card-fitta">
          <div class="riga-lista">
            <span class="icona"><%- iconaOrdini %></span>
            <span class="corpo">
              <span class="etichetta">Ordine #<%= ordine.id %></span>
              <span class="dettaglio"><%= fmt.dataOra(ordine.creato_il) %></span>
            </span>
            <span class="stato-badge <%= ordine.consegnato_il ? 'stato-consegnato' : 'stato-' + ordine.stato %>">
              <%= ordine.consegnato_il ? 'Consegnato' : (ordine.stato === 'inviato' ? 'Inviato' : (ordine.stato === 'in_evasione' ? 'In preparazione' : 'Partito')) %>
            </span>
          </div>
          <% if (distributore) { %>
            <div class="riga-lista">
              <span class="icona"><%- iconaNegozio %></span>
              <span class="corpo">
                <span class="etichetta"><%= distributore.nome %></span>
                <span class="dettaglio"><%= distributore.filiale %></span>
              </span>
            </div>
          <% } %>
          <div class="riga-lista">
            <span class="icona"><%- iconaPersona %></span>
            <span class="corpo">
              <span class="etichetta"><%= cliente.ragione_sociale %></span>
              <span class="dettaglio"><%= cliente.telefono || '—' %></span>
            </span>
          </div>
          <div class="riga-lista">
            <span class="icona"><%- iconaConsegna %></span>
            <span class="corpo">
              <span class="etichetta">
                <%= ordine.modalita === 'ritiro' ? 'Ritiro al banco' : 'Consegna con mezzo del distributore' %>
              </span>
              <span class="dettaglio">
                <% if (ordine.corriere_arrivo_il) { %>Consegna con corriere, prevista entro le <%= fmt.oraRoma(ordine.corriere_arrivo_il) %>
                <% } else { %>
                <% if (ordine.partenza_ore) { %>Partenza stimata: <%= fmt.tempoConsegna(ordine.partenza_ore) %> · <% } %>
                <%= ordine.consegna_ore ? 'consegna stimata: ' + fmt.tempoConsegna(ordine.consegna_ore) : 'tempo da concordare' %>
                <% } %>
              </span>
            </span>
          </div>
          <% if (ordine.destinazione) { %>
            <div class="riga-lista">
              <span class="icona"><%- iconaDestinazione %></span>
              <span class="corpo">
                <span class="etichetta">Destinazione merce</span>
                <span class="dettaglio"><%= ordine.destinazione %></span>
              </span>
            </div>
          <% } %>
          <% if (pagamento) { %>
            <div class="riga-lista">
              <span class="icona"><%- iconaPagamento %></span>
              <span class="corpo">
                <span class="etichetta">Pagamento: <%= pagamento.stato === 'rimborsato' ? 'rimborsato' : 'pagato' %> € <%= euro(pagamento.importo) %></span>
                <span class="dettaglio"><%= pagamento.metodo === 'simulato' ? 'Pagamento di prova · ' : '' %>il <%= fmt.dataOra(pagamento.pagato_il) %></span>
              </span>
            </div>
          <% } %>
          <% if (ordine.ddt_numero) { %>
            <a class="riga-lista" href="/ddt/<%= ordine.id %>">
              <span class="icona"><%- iconaFiscale %></span>
              <span class="corpo">
                <span class="etichetta">Bolla / DDT n. <%= ordine.ddt_numero %></span>
                <span class="dettaglio">Del <%= fmt.dataSola(ordine.ddt_data) %> — intestata a <%= cliente.ragione_sociale %></span>
              </span>
              <span class="freccia">›</span>
            </a>
          <% } %>
          <% if (ordine.note) { %>
            <div class="riga-lista">
              <span class="icona"><%- iconaNota %></span>
              <span class="corpo">
                <span class="etichetta">Note</span>
                <span class="dettaglio"><%= ordine.note %></span>
              </span>
            </div>
          <% } %>
        </div>

        <div class="sezione-titolo">Prodotti</div>
        <div class="card">
          <% righe.forEach(function (r) { %>
            <div class="riga-articolo">
              <div class="qta"><%= r.quantita %>×</div>
              <div class="desc">
                <%= r.nome_snapshot %>
                <div class="meta">Cod. <%= r.codice_snapshot %> · € <%= euro(r.prezzo_unitario_cliente) %> cad. + IVA</div>
              </div>
              <div class="imp">€ <%= euro(r.subtotale_cliente) %></div>
            </div>
          <% }); %>
        </div>

        <div class="card">
          <div class="riepilogo-riga">
            <span class="voce">Merce (IVA esclusa)</span>
            <span>€ <%= euro(ordine.totale_finale) %></span>
          </div>
          <% if (ordine.contributo_raee > 0) { %>
            <div class="riepilogo-riga">
              <span class="voce">Contributo RAEE</span>
              <span>€ <%= euro(ordine.contributo_raee) %></span>
            </div>
          <% } %>
          <div class="riepilogo-riga">
            <span class="voce">Costo di consegna</span>
            <span><%= ordine.costo_consegna > 0 ? '€ ' + euro(ordine.costo_consegna) : 'inclusa' %></span>
          </div>
          <div class="riepilogo-riga">
            <span class="voce">IVA <%= ivaPct %>%</span>
            <span>€ <%= euro(ordine.iva) %></span>
          </div>
          <div class="riepilogo-riga forte">
            <span class="voce">Totale</span>
            <span>€ <%= euro(totaleOrdine(ordine)) %></span>
          </div>
        </div>

        <p class="nota">
          Il prezzo definitivo, con eventuale sconto aggiuntivo, sarà confermato in fattura
          come di consueto.
        </p>

        <% if (currentUser.ruolo === 'distributore') { %>
          <form method="POST" action="/distributore/ordini/<%= ordine.id %>/elimina" onsubmit="return confirm('Eliminare definitivamente questo ordine?')">
            <button class="btn btn-rosso btn-blocco" type="submit" style="margin-top:8px;">Elimina ordine</button>
          </form>
        <% } %>

      <% } %>
    </div>
  </div>

  <% if (currentUser.ruolo === 'cliente') { %>
    <%- include('partials/nav', { attivo: 'ordini' }) %>
  <% } %>
  <script src="<%= asset('/app.js') %>" defer></script>
  <script src="<%= asset('/mappa.js') %>" defer></script>
</body>
</html>
