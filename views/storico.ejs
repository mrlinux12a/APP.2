<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
</head>
<body data-loggato="1">
  <div class="app app-storico">
    <%- include('partials/appbar', { titolo, intestazione: 'Storico ordini', indietro: '/home' }) %>

    <div class="contenuto">
      <% if (!inCorso.length && !mesi.length) { %>
        <div class="vuoto">
          <span class="emoji"><%- iconaVuotoScatola %></span>
          Nessun ordine ancora.
        </div>
        <a class="btn btn-primary btn-blocco" href="/home">Vai al catalogo</a>
      <% } else { %>
        <% if (inCorso.length) { %>
          <h2 class="st-titolo">In corso</h2>
          <% inCorso.forEach(function (v) { %><%- include('partials/storico_scheda', { v }) %><% }); %>
        <% } %>
        <% mesi.forEach(function (mese) { %>
          <h2 class="st-titolo"><%= mese.titolo %></h2>
          <% mese.voci.forEach(function (v) { %><%- include('partials/storico_scheda', { v }) %><% }); %>
        <% }); %>
      <% } %>
    </div>
  </div>

  <%- include('partials/nav', { attivo: '' }) %>
  <script src="<%= asset('/app.js') %>" defer></script>
</body>
</html>
