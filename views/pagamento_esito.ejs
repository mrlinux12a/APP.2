<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
  <%# Il pagamento è già autorizzato e la richiesta sta nascendo (la crea il webhook di Stripe o questa stessa pagina):
      si ricarica da sola finché non è pronta, poi /pagamento/esito porta alla schermata di attesa. %>
  <meta http-equiv="refresh" content="2">
</head>
<body data-loggato="1">
  <div class="app">
    <%- include('partials/appbar', { titolo, indietro: '/carrello' }) %>
    <div class="contenuto">
      <div class="avviso avviso-info" role="status">Pagamento ricevuto: sto inviando la richiesta ai banchi…</div>
    </div>
  </div>
  <script src="<%= asset('/app.js') %>" defer></script>
</body>
</html>
