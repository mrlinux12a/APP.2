<%
  const str = (typeof striscia !== 'undefined' && striscia) ? striscia : null;
  // Anello: stessa durata e stessa formula di partials/nav_ordini.ejs (e dello script in fondo a quel file,
  // che muove ogni [data-countdown] e [data-arco] della pagina, ognuno col conto del suo [data-secondi] più vicino: qui è
  // .contenuto, cioè i secondi di QUESTA richiesta, non quelli dell'icona, che con più richieste segue un'altra). Circonferenza = 2 * PI * 64.
  const CIRC_ATTESA = 402.12;
  // La durata è la finestra di conferma, non "scade_il - creato_il": una richiesta rinviata ha creato_il di prima e l'anello
  // partirebbe quasi vuoto (fmt.durataFinestraSec).
  const durataFinestra = fmt.durataFinestraSec(richiesta.creato_il, richiesta.scade_il, typeof minutiRisposta !== 'undefined' ? minutiRisposta : 10);
  const offsetAnello = (CIRC_ATTESA * (1 - secondi / durataFinestra)).toFixed(2);
%>
<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
</head>
<body data-loggato="1"<%- str ? ' class="con-striscia"' : '' %>>
  <div class="app">
    <%- include('partials/appbar', { titolo, intestazione: str ? 'Stato ordini' : 'Verifica disponibilità', indietro: str ? null : '/home' }) %>
    <% if (str) { %><%- include('partials/striscia_ordini', { striscia: str }) %><% } %>

    <div class="contenuto" data-attesa="<%= richiesta.id %>" data-secondi="<%= secondi %>" data-durata="<%= durataFinestra %>">
      <%# 1. Timer e passaggi %>
      <div class="card att-card att-timer">
        <div class="att-anello">
          <svg viewBox="0 0 148 148" aria-hidden="true">
            <circle class="traccia" cx="74" cy="74" r="64"/>
            <circle class="avanzamento" data-arco data-circ="<%= CIRC_ATTESA %>" cx="74" cy="74" r="64" style="stroke-dashoffset: <%= offsetAnello %>"/>
          </svg>
          <span class="att-tempo" data-countdown><%= fmt.mmss(secondi) %></span>
        </div>
        <h2 class="att-titolo"><span class="att-punto" aria-hidden="true"></span>Stiamo chiedendo al banco</h2>
        <ol class="att-passi">
          <li class="att-passo att-fatto">
            <span class="att-barretta"></span>
            <span class="att-etichetta"><span class="att-spunta" aria-hidden="true"><svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>Inviata</span>
          </li>
          <li class="att-passo att-corrente" aria-current="step">
            <span class="att-barretta"></span>
            <span class="att-etichetta">Conferma banco</span>
          </li>
          <li class="att-passo">
            <span class="att-barretta"></span>
            <span class="att-etichetta">In consegna</span>
          </li>
        </ol>
      </div>

      <%# 2. Banco interpellato (una scheda per banco). Lo script della pagina aggiorna l'etichetta di stato
          cercando [data-distributore] dentro #stato-distributori. %>
      <div id="stato-distributori">
        <% risposte.forEach(function (r) { %>
          <div class="card att-card att-banco">
            <span class="att-icona" aria-hidden="true"><%- iconaNegozio %></span>
            <div class="att-banco-testo">
              <div class="att-occhiello">Banco interpellato</div>
              <div class="att-banco-nome"><%= r.distributore_nome %></div>
            </div>
            <span class="stato-badge stato-<%= r.esito %>" data-distributore="<%= r.distributore_nome %>"><%= r.esito === 'in_attesa' ? 'Sta verificando' : (r.esito === 'confermato' ? 'Disponibile' : (r.esito === 'non_disponibile' ? 'Non disponibile' : 'Nessuna risposta')) %></span>
          </div>
        <% }); %>
      </div>

      <%# 3. Materiale richiesto: righe a prezzo del banco, IVA esclusa, e "Merce · IVA esclusa · prezzi del banco" %>
      <%- include('partials/richiesta_materiale', { righePrezzi, importi }) %>

      <%# 4. Pagamenti: in app si paga solo la consegna (corriere + servizio + IVA); il materiale lo si paga a BOREA solo se un banco conferma (in sospeso).
          Stessa scheda della pagina dell'ordine e di "Nessuna risposta", con lo stato 'attesa'. Una richiesta del vecchio flusso (mai pagata) non l'ha. %>
      <% if (importi.app.conPagamento) { %>
        <%- include('partials/pagamenti', { importi, stato: 'attesa', ditta, statoPag }) %>
      <% } %>

      <%# 5. Annulla, SOLO in fase 1: richiesta in attesa e nessun banco ha ancora accettato (`annullabile`). Sparisce appena un banco conferma: al
          ricaricamento, o prima, dal polling di app.js (`data-annulla-richiesta`). "Elimina definitivamente" non c'è più: mentre si aspetta il banco si
          annulla soltanto (l'eliminazione sta nella pagina della richiesta chiusa). %>
      <form method="POST" action="/richieste/<%= richiesta.id %>/annulla" data-annulla-richiesta<%= annullabile ? '' : ' hidden' %>>
        <button class="att-annulla" type="submit">Annulla la richiesta</button>
      </form>
    </div>
  </div>

  <%- include('partials/nav', { attivo: 'ordini' }) %>
  <script src="<%= asset('/app.js') %>" defer></script>
</body>
</html>
