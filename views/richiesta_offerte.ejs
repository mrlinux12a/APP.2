<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
</head>
<body data-loggato="1">
  <div class="app">
    <%- include('partials/appbar', { titolo, intestazione: 'Riepilogo offerte', indietro: '/home' }) %>

    <% const aperta = richiesta.stato === 'con_offerte'; %>
    <div class="contenuto"<% if (aperta) { %> data-offerte-live="<%= richiesta.id %>" data-conferme="<%= offerte.length %>"<% } %>>
      <% if (richiesta.stato === 'annullata') { %>
        <div class="avviso avviso-attenzione">Hai annullato questa richiesta.</div>
      <% } else if (richiesta.stato === 'nessuna_offerta' && offerte.length) { %>
        <div class="avviso avviso-attenzione">
          Le offerte sono scadute senza che venisse scelto un distributore, quindi nessun ordine
          è partito. Puoi reinviare la richiesta per avere conferme aggiornate.
        </div>
      <% } else if (!offerte.length) { %>
        <div class="avviso avviso-attenzione">
          Nessun distributore ha confermato la disponibilità entro i <%= Math.round(minutiRisposta) %> minuti.
          La mancata risposta non vale come disponibilità: il materiale potrebbe esserci
          ma non essere reperibile al banco.
        </div>
      <% } else { %>
        <div class="avviso avviso-ok">
          <strong><%= offerte.length %></strong>
          <%= offerte.length === 1 ? 'distributore ha confermato' : 'distributori hanno confermato' %>
          la disponibilità. Scegli con chi ordinare.
        </div>
      <% } %>

      <% if (aperta && secondiScelta !== null && secondiScelta > 0) { %>
        <div class="avviso avviso-attenzione conto-scelta" data-scelta data-secondi="<%= secondiScelta %>">
          Hai <strong><span id="countdown-scelta"><%= fmt.mmss(secondiScelta) %></span></strong>
          per scegliere. Se non scegli, l'ordine parte da solo verso
          <strong><%= nomeAssegnazione %></strong> (consegna più veloce tra chi copre tutto il materiale).
        </div>
      <% } else if (aperta && secondiScelta === 0) { %>
        <div class="avviso avviso-attenzione">
          Il tempo per scegliere è scaduto: l'ordine sta per partire verso
          <strong><%= nomeAssegnazione %></strong>.
        </div>
      <% } %>

      <% (aperta ? offerte : []).forEach(function (o, i) { %>
        <a class="offerta <%= i === 0 && offerte.length > 1 && o.copertura === 'totale' ? 'migliore' : '' %>"
           href="/richieste/<%= richiesta.id %>/offerta/<%= o.distributore.id %>">
          <div class="testa">
            <div>
              <div class="nome"><%= o.distributore.nome %></div>
              <div class="filiale"><%= o.distributore.filiale %></div>
            </div>
            <div class="totale">
              <div class="valore">€ <%= euro(o.totali.imponibile) %></div>
              <div class="iva">+ IVA</div>
            </div>
          </div>

          <% if (o.copertura === 'parziale') { %>
            <div class="tempo">
              <span class="stato-badge stato-con_offerte">Disponibilità parziale</span>
            </div>
            <div class="tempo" style="color:var(--rosso);">
              <%- iconaAvviso %> Mancano
              <% o.mancanti.forEach(function (m, k) { %><%= k ? ', ' : '' %><%= m.mancano %> pz di <%= m.nome %><% }); %>
            </div>
          <% } else { %>
            <div class="tempo">
              <span class="stato-badge stato-confermato">Disponibilità totale</span>
            </div>
          <% } %>

          <div class="tempo"><%- iconaOrario %> Parte dalla filiale entro <%= fmt.tempoConsegna(o.partenza_ore) %></div>
          <div class="tempo">
            <%- iconaConsegna %> Da te in <strong><%= consegna.inParole(o.consegna_minuti_stimati) %></strong>
            <% if (o.distributore.id === idPiuVeloce && offerte.length > 1) { %>
              <span class="stato-badge stato-confermato">più veloce</span>
            <% } %>
          </div>
          <div class="tempo">
            <%- iconaOrdini %> Merce € <%= euro(o.totali.totale_finale) %> + IVA ·
            <%= o.totali.costo_consegna > 0 ? 'consegna € ' + euro(o.totali.costo_consegna) : 'consegna inclusa' %>
          </div>
          <% if (o.note) { %>
            <div class="tempo"><%- iconaNota %> <%= o.note %></div>
          <% } %>
          <% if (i === 0 && offerte.length > 1 && o.copertura === 'totale') { %>
            <div class="tempo" style="color:var(--verde); font-weight:600;">✓ Offerta più conveniente</div>
          <% } %>
          <div class="piede">
            <span>Procedi con l'ordine</span>
            <span>›</span>
          </div>
        </a>
      <% }); %>

      <% if (risposte.some(function (r) { return r.esito !== 'confermato'; })) { %>
        <div class="sezione-titolo">Altri distributori interpellati</div>
        <div class="card card-fitta">
          <% risposte.filter(function (r) { return r.esito !== 'confermato'; }).forEach(function (r) { %>
            <div class="pill-distributore">
              <div>
                <div class="nome"><%= r.distributore_nome %></div>
                <div class="filiale"><%= r.filiale %></div>
              </div>
              <span class="stato-badge stato-<%= r.esito %>">
                <%= r.esito === 'non_disponibile' ? 'Non disponibile' : (r.esito === 'in_attesa' ? 'In attesa' : 'Nessuna risposta') %>
              </span>
            </div>
          <% }); %>
        </div>
      <% } %>

      <div class="sezione-titolo">Materiale richiesto</div>
      <div class="card">
        <% righe.forEach(function (r) { %>
          <div class="riga-articolo">
            <div class="qta"><%= r.quantita %>×</div>
            <div class="desc">
              <%= r.nome %>
              <div class="meta">Cod. <%= r.codice %></div>
            </div>
          </div>
        <% }); %>
      </div>

      <p class="nota">Prezzi IVA esclusa, già comprensivi del servizio. Richiesta del <%= fmt.dataOra(richiesta.creato_il) %>.</p>

      <% if (richiesta.stato === 'nessuna_offerta') { %>
        <form method="POST" action="/richieste/<%= richiesta.id %>/reinvia">
          <button class="btn btn-primary btn-blocco" type="submit">Riinvia richiesta</button>
        </form>
      <% } else if (!aperta) { %>
        <a class="btn btn-primary btn-blocco" href="/home">Torna alla home</a>
      <% } %>
      <% if (aperta) { %>
        <form method="POST" action="/richieste/<%= richiesta.id %>/annulla">
          <button class="btn btn-chiaro btn-blocco" type="submit" style="margin-top:12px;">Annulla la richiesta</button>
        </form>
      <% } %>
      <form method="POST" action="/richieste/<%= richiesta.id %>/elimina" onsubmit="return confirm('Eliminare definitivamente questa richiesta?')">
        <button class="btn btn-rosso btn-blocco" type="submit" style="margin-top:8px;">Elimina richiesta</button>
      </form>
    </div>
  </div>

  <%- include('partials/nav', { attivo: 'ordini' }) %>
  <script src="/app.js" defer></script>
</body>
</html>
