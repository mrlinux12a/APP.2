<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
</head>
<body data-loggato="1">
  <div class="app<%= righe.length ? ' app-carrello' : '' %>">
    <%- include('partials/appbar', { titolo, intestazione: 'Carrello' }) %>

    <% if (!righe.length) { %>
      <div class="contenuto">
        <% if (avviso) { %><div class="avviso avviso-attenzione" role="status"><%= avviso %></div><% } %>
        <div class="vuoto">
          <span class="emoji"><%- iconaCarrello %></span>
          Il carrello è vuoto.
          <div style="margin-top:6px;font-size:0.9rem;">Aggiungi articoli dalle categorie o dalla ricerca.</div>
        </div>
        <a class="btn btn-primary btn-blocco" href="/home">Vai al catalogo</a>
        <a class="btn btn-chiaro btn-blocco" href="/cerca" style="margin-top:8px;">Cerca un pezzo</a>
      </div>
    <% } else { %>
      <%
        // L'indirizzo è una riga sola ("Via Puggia 22/3, 16131 Genova (GE)"): la via in evidenza, il resto sotto.
        const indirizzo = (cliente.indirizzo_consegna || '').trim();
        const taglio = indirizzo.indexOf(',');
        const via = taglio === -1 ? indirizzo : indirizzo.slice(0, taglio).trim();
        const capCitta = taglio === -1 ? '' : indirizzo.slice(taglio + 1).trim();
      %>
      <div class="contenuto">
        <% if (avviso) { %><div class="avviso avviso-attenzione" role="status"><%= avviso %></div><% } %>
        <div class="carrello-layout">
          <div class="carrello-articoli">
            <div class="carrello-testata">
              <a class="link-aggiungi" href="/home">+ Aggiungi pezzi</a>
            </div>

            <form method="POST" action="/carrello" id="form-carrello">
              <input type="hidden" name="modo" value="imposta">
              <input type="hidden" name="ritorno" value="/carrello">
              <% righe.forEach(function (r) { %>
                <% const unitario = prezzoCliente(r.prodotto); %>
                <div class="card carrello-articolo" data-riga="<%= r.prodotto.id %>">
                  <div class="art-nome">
                    <% if (r.prodotto.brand_slug) { %><span class="marchio-tag" style="--marchio:#1d4e89"><%= r.prodotto.brand_slug.toUpperCase() %></span><% } %>
                    <%= r.prodotto.nome %>
                  </div>
                  <div class="art-prezzo">€ <%= euro(unitario) %> cad. · IVA esclusa</div>
                  <div class="art-azioni">
                    <button type="button" class="btn-cestino" data-rimuovi="<%= r.prodotto.id %>" aria-label="Rimuovi dal carrello"><%- iconaCestino %></button>
                    <div class="stepper" data-stepper-carrello="<%= r.prodotto.id %>">
                      <button type="button" data-passo-carrello="-1" aria-label="Togli" <%= r.quantita <= 1 ? 'disabled' : '' %>>−</button>
                      <input type="number" min="1" max="9999" step="1" inputmode="numeric"
                             name="quantita_<%= r.prodotto.id %>" value="<%= r.quantita %>"
                             data-qta-carrello-input="<%= r.prodotto.id %>"
                             aria-label="Quantità <%= r.prodotto.nome %>">
                      <button type="button" data-passo-carrello="1" aria-label="Aggiungi">+</button>
                    </div>
                    <span class="art-totale">€ <%= euro(unitario * r.quantita) %></span>
                  </div>
                </div>
              <% }); %>
            </form>
            <%# Svuotare chiede conferma: il pulsante è in fondo alla pagina e punta a questo form (form="form-svuota"). %>
            <form method="POST" action="/carrello/svuota" id="form-svuota" onsubmit="return confirm('Svuotare il carrello?')"></form>
          </div>

          <div class="carrello-riepilogo">
            <% if (!raggiunto) { %>
              <div class="avviso avviso-attenzione">
                <strong>Ordine minimo € <%= euro(minimo) %></strong> di merce, IVA e spedizione escluse.
                Ti mancano <strong>€ <%= euro(mancaAlMinimo) %></strong>.
              </div>
            <% } %>

            <form method="POST" action="/richieste" id="form-invia" data-invia-carrello>
              <input type="hidden" name="modo" value="imposta">

              <%# Consegna: il campo "destinazione" è lo stesso di prima, si apre con "Cambia" (o subito, se l'indirizzo è vuoto). %>
              <div class="card consegna-card" data-consegna>
                <div class="consegna-riga">
                  <span class="consegna-ico"><%- iconaPosizione %></span>
                  <div class="consegna-testo">
                    <span class="consegna-occhiello">Consegna in cantiere</span>
                    <span class="consegna-via" data-consegna-via><%= via %></span>
                    <span class="consegna-citta" data-consegna-citta><%= capCitta %></span>
                  </div>
                  <button type="button" class="btn-cambia" data-consegna-cambia><%= indirizzo ? 'Cambia' : 'Fatto' %></button>
                </div>
                <div class="consegna-campo" data-consegna-campo <%= indirizzo ? 'hidden' : '' %>>
                  <input type="text" id="destinazione" name="destinazione"
                         value="<%= cliente.indirizzo_consegna || '' %>"
                         placeholder="Via, numero, CAP, città" aria-label="Indirizzo di consegna">
                </div>
              </div>

              <%# Nota facoltativa: la textarea è quella di prima (name="note"), si apre toccando il riquadro. %>
              <details class="nota-dett" data-nota>
                <summary>
                  <span class="nota-piu" aria-hidden="true">+</span>
                  <span class="nota-testi">
                    <span class="nota-titolo">Aggiungi una nota per il banco</span>
                    <span class="nota-sotto">Facoltativa: orario, riferimento cantiere…</span>
                  </span>
                </summary>
                <textarea name="note" rows="2" maxlength="500" aria-label="Nota per il banco"
                          placeholder="Es. orario preferito, riferimento cantiere..."></textarea>
              </details>

              <%# Il riepilogo sta in fondo, subito prima del tasto che paga (ora nella barra fissa). %>
              <div class="card riepilogo-card">
                <div class="riepilogo-riga">
                  <span class="voce">Merce (IVA esclusa)</span>
                  <span>€ <%= euro(totali.totale_finale) %></span>
                </div>
                <% if (totali.contributo_raee > 0) { %>
                  <div class="riepilogo-riga">
                    <span class="voce">Contributo RAEE</span>
                    <span>€ <%= euro(totali.contributo_raee) %></span>
                  </div>
                <% } %>
                <div class="riepilogo-riga">
                  <span class="voce">Consegna in cantiere</span>
                  <span>€ <%= euro(spedizione) %></span>
                </div>
                <div class="riepilogo-riga">
                  <span class="voce">IVA <%= ivaPct %>%</span>
                  <span>€ <%= euro(totali.iva) %></span>
                </div>
                <div class="riepilogo-riga forte">
                  <span class="voce">Totale</span>
                  <span>€ <%= euro(totali.totale_ivato) %></span>
                </div>
              </div>
            </form>

            <button class="svuota-fondo" type="submit" form="form-svuota">Svuota carrello</button>
          </div>
        </div>
      </div>

      <%# Barra di pagamento fissa, sopra la navbar. Il pulsante invia il form "form-invia" (come il vecchio
          "Paga … e invia la richiesta"); totale e importi si aggiornano con la pagina, che si ricarica a ogni
          cambio di quantità. %>
      <div class="barra-paga">
        <div class="barra-paga-interno">
          <div class="barra-paga-riga">
            <div class="bp-totale">
              <span class="bp-label">Totale IVA inclusa</span>
              <span class="bp-importo">€ <%= euro(totali.totale_ivato) %></span>
            </div>
            <button class="btn-paga" type="submit" form="form-invia" <%= raggiunto ? '' : 'disabled' %>>Paga e invia richiesta</button>
          </div>
          <p class="barra-paga-nota">
            <span class="scudo"><%- iconaScudo %></span>
            <span>I banchi rispondono entro <%= Math.round(minutiRisposta) %> min · se nessuno accetta, rimborso</span>
          </p>
        </div>
      </div>
    <% } %>
  </div>

  <%- include('partials/nav', { attivo: 'carrello' }) %>
  <script src="<%= asset('/app.js') %>" defer></script>
</body>
</html>
