<%#
  Schede "Stato ordine" in cima alla home dell'installatore: UNA per ogni richiesta in attesa (anello che si svuota + conto alla
  rovescia) e per ogni ordine in consegna (minuti, corriere, avanzamento), una sotto l'altra, tutte nello stesso formato. Con una sola
  attività è la scheda di sempre. L'ordine è quello delle voci dell'icona in basso e della striscia di "Stato ordini": le richieste dal
  timer più corto, poi le consegne dall'arrivo più vicino. La richiesta scaduta da rinviare non ha scheda (come prima: si vede
  nell'icona e nella striscia). Ogni scheda porta alla pagina della sua attività.
  Legge le voci dell'icona (res.locals.statoOrdini.voci). Anello e conto alla rovescia li aggiorna lo script di nav_ordini.ejs (elementi
  [data-arco] e [data-countdown], col conto del suo [data-secondi]: ogni richiesta ha il suo); quando le voci cambiano lo stesso script
  rimpiazza tutte le schede con GET /nav/stato-ordini?scheda=1.
  Il contenitore [data-stato-home] c'è sempre, anche vuoto, perché è lì che le schede possono comparire.
%>
<%
  const soHome = (typeof statoOrdini !== 'undefined' && statoOrdini) ? statoOrdini : null;
  const schede = soHome && Array.isArray(soHome.voci) ? soHome.voci.filter(function (v) { return v.fase === 'richiesta' || v.fase === 'consegna'; }) : [];
  const CIRC_SCHEDA = 150.8; // 2 * PI * 24
%>
<div class="stato-home-slot" data-stato-home>
<% schede.forEach(function (v) { %>
<% if (v.fase === 'richiesta') { %>
  <%
    const durataScheda = v.durata || 600;
    const offsetScheda = (CIRC_SCHEDA * (1 - v.secondi / durataScheda)).toFixed(2);
    const minutiFinestra = Math.max(1, Math.round(durataScheda / 60));
  %>
  <a class="stato-home stato-richiesta" href="<%= v.href %>" data-secondi="<%= v.secondi %>" data-durata="<%= durataScheda %>">
    <div class="stato-riga">
      <span class="stato-anello">
        <svg viewBox="0 0 56 56" aria-hidden="true">
          <circle class="traccia" cx="28" cy="28" r="24"/>
          <circle class="avanzamento" data-arco data-circ="<%= CIRC_SCHEDA %>" cx="28" cy="28" r="24" style="stroke-dashoffset: <%= offsetScheda %>"/>
        </svg>
        <span class="stato-tempo" data-countdown><%= fmt.mmss(v.secondi) %></span>
      </span>
      <span class="stato-testi">
        <span class="stato-occhiello">Richiesta inviata</span>
        <span class="stato-titolo">Aspettiamo che un banco accetti</span>
        <span class="stato-sub">Se nessuno accetta entro <%= minutiFinestra %> min, ti rimborsiamo.</span>
      </span>
      <span class="stato-freccia" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></span>
    </div>
  </a>
<% } else { %>
  <%
    const nomeCorriere = v.corriere || '';
    // Con l'orario d'arrivo minuti, "In arrivo" (3 min o meno) e barra li fa scendere da soli il browser, col suo orologio
    // (public/app.js, "Consegna in arrivo"): ogni scheda ha il suo [data-eta-sec]. Senza orario: "In consegna" e barra a metà, ferme.
    const conEta = v.minuti != null && v.etaSec != null;
  %>
  <div class="stato-home stato-consegna"<%- conEta ? ' data-eta-sec="' + v.etaSec + '"' + (v.durataSec ? ' data-eta-durata="' + v.durataSec + '"' : '') : '' %>>
   <a class="stato-corpo" href="<%= v.href %>">
    <div class="stato-riga">
      <span class="stato-furgone"><span class="furgone"><%- iconaFurgone %></span></span>
      <span class="stato-testi">
        <span class="stato-occhiello">Accettato · In consegna</span>
        <span class="stato-titolo"<%- conEta ? ' data-eta-testo="Arriva tra {t}"' : '' %>><%= v.minuti == null ? 'In consegna' : (v.inArrivo ? 'In arrivo' : 'Arriva tra ' + fmt.durataMinuti(v.minuti)) %></span>
        <% if (nomeCorriere) { %>
          <span class="stato-sub">
            <span class="stato-iniziale" aria-hidden="true"><%= Array.from(nomeCorriere)[0].toUpperCase() %></span>
            <span>Te lo porta <strong><%= nomeCorriere %></strong></span>
          </span>
        <% } %>
      </span>
      <span class="stato-freccia" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></span>
    </div>
    <div class="stato-barra" aria-hidden="true"><span<%- conEta && v.durataSec ? ' data-eta-barra="da-meta"' : '' %> style="width: <%= conEta && v.durataSec ? ((v.progresso != null ? v.progresso : 0.5) * 100).toFixed(1) : Math.round((v.progresso != null ? v.progresso : 0.5) * 100) %>%"></span></div>
   </a>
    <%# La barra avanza col tempo fino all'arrivo previsto (a metà, "In viaggio", se non c'è l'orario). "Consegnato" qui è solo
        un'etichetta: non si può toccare. La consegna la segna il corriere dal gruppo WhatsApp (nessun pulsante per l'installatore). %>
    <div class="stato-tappe" aria-hidden="true">
      <span>Accettato</span>
      <span>In viaggio</span>
      <span>Consegnato</span>
    </div>
  </div>
<% } %>
<% }); %>
</div>
