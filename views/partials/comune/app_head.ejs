<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#f3f1ec">
<%# Pagine del banco (`senzaTelefoni`): un numero di telefono resta testo, nemmeno l'iPhone lo trasforma in un collegamento da toccare. %>
<% if (typeof senzaTelefoni !== 'undefined' && senzaTelefoni) { %><meta name="format-detection" content="telephone=no"><% } %>
<%# L'utente collegato: assets/js ci lega le quantità scelte e non ancora aggiunte al carrello (un altro utente sulla stessa scheda non le vede). %>
<% if (typeof currentUser !== 'undefined' && currentUser) { %><meta name="utente" content="<%= currentUser.id %>"><% } %>
<%# Notifiche ad app chiusa (src/logica/notifiche/web_push.js, assets/js "Notifiche anche ad app chiusa"): la chiave con cui il browser si iscrive (assente = push spente) e l'iscrizione che il server ha già per questa sessione. %>
<% if (typeof pushChiave !== 'undefined' && pushChiave) { %><meta name="push-chiave" content="<%= pushChiave %>"><meta name="push-endpoint" content="<%= typeof pushEndpoint !== 'undefined' ? pushEndpoint : '' %>"><% } %>
<%# PWA: manifest e icone (public/manifest.webmanifest, public/icons). Senza <link rel="icon"> il browser chiede /favicon.ico a ogni pagina. %>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" href="/icons/icona-192.png" type="image/png">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Flash Delivery">
<%# Installata su iPhone la barra di stato prende il colore della pagina (chiara, come l'appbar) invece di coprirla di nero. %>
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<title><%= typeof titolo !== 'undefined' ? titolo : 'Flash Delivery' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<%# I font si caricano senza bloccare il disegno della pagina: con una rete debole da cantiere un foglio di stile
    esterno "bloccante" teneva la pagina bianca finché Google non rispondeva. Nel frattempo valgono i font di sistema. %>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Source+Sans+3:wght@400;600&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Source+Sans+3:wght@400;600&display=swap"></noscript>
<%# Pagine del banco (restyling del 10/11/2026): in più Inter (testo) e Space Grotesk (titoli e timer grandi) per l'intestazione, la bacheca e il popup "Ispeziona". Si caricano
    solo per il distributore, nello stesso modo non bloccante. %>
<% if (typeof currentUser !== 'undefined' && currentUser && currentUser.ruolo === 'distributore') { %>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"></noscript>
<% } %>
<link rel="stylesheet" href="<%= asset('/style.css') %>">
