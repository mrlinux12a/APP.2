<%
  // `base` è un indirizzo che ha già una query string; `parametro` (default "p") e `unita` (default "prodotti") servono alle
  // pagine che non sono il catalogo (lo Storico ordini del banco: parametro "pagina", unita "ordini").
  const nomeParametro = typeof parametro !== 'undefined' && parametro ? parametro : 'p';
  const nomeUnita = typeof unita !== 'undefined' && unita ? unita : 'prodotti';
%>
<% if (elenco.pagine > 1) { %>
  <div class="paginazione">
    <% if (elenco.pagina > 1) { %>
      <a class="btn btn-chiaro" href="<%= base %>&amp;<%= nomeParametro %>=<%= elenco.pagina - 1 %>">‹ Precedente</a>
    <% } else { %>
      <span class="btn btn-chiaro" aria-disabled="true">‹ Precedente</span>
    <% } %>
    <span class="conta-pagina">
      Pagina <%= elenco.pagina %> di <%= elenco.pagine %> · <%= elenco.totale %> <%= nomeUnita %>
    </span>
    <% if (elenco.pagina < elenco.pagine) { %>
      <a class="btn btn-chiaro" href="<%= base %>&amp;<%= nomeParametro %>=<%= elenco.pagina + 1 %>">Successiva ›</a>
    <% } else { %>
      <span class="btn btn-chiaro" aria-disabled="true">Successiva ›</span>
    <% } %>
  </div>
<% } %>
