<%
  // Intestazione del banco, UNA SOLA per tutte le pagine del distributore (home, clienti, storico ordini, richieste,
  // notifiche, errori...): barra bianca con ditta e filiale, schede Banco / Clienti / Storico ordini (una scheda del menu come le altre, dopo
  // Clienti: richiesta esplicita del 19/10/2026, prima era un pulsante accanto al cerchio) e cerchio con le iniziali che apre la tendina.
  // Sotto i 900px le schede spariscono e c'è il menu in basso (partials/nav_distributore.ejs, con le stesse tre voci).
  // Chi non è la home la riceve da partials/appbar.ejs, che per il distributore delega
  // qui: non scrivere un'altra intestazione per il banco. Niente campanella delle notifiche (tolta su richiesta).
  // Dati: bancoTesta (nome e filiale, res.locals, in cache), contatori, percorso (req.path), primaScadeSec (res.locals).
  // Avvisi del banco (richiesta esplicita del 20/10/2026, public/app.js "Avvisi del banco"): pallino arancio col numero di richieste da confermare sulla scheda
  // "Banco" (su tutte le pagine, anche la home), striscia arancio sotto l'intestazione (partials/banco_avviso.ejs, NON sulla home: lì le colonne mostrano già
  // tutto) e, dallo script, notifiche a comparsa. L'attributo data-banco-testa dice allo script che la pagina è del banco (data-ditta: il nome per il titolo della scheda).
  // Parametri facoltativi: intestazione e indietro, solo per le pagine interne: sotto la barra compare una riga con la
  // freccia e il titolo della pagina. La home non li passa.
  const perc = typeof percorso !== 'undefined' ? String(percorso) : '';
  // "Storico ordini" è accesa anche dentro un ordine (/distributore/ordini/:id): l'ordine fa parte dello storico.
  const sezione = perc === '/distributore' || perc.indexOf('/distributore/richieste') === 0 ? 'banco'
    : perc.indexOf('/distributore/clienti') === 0 ? 'clienti'
    : perc.indexOf('/distributore/storico') === 0 || perc.indexOf('/distributore/ordini') === 0 ? 'storico'
    : '';
  const testa = typeof bancoTesta !== 'undefined' && bancoTesta ? bancoTesta : {};
  const nomeDitta = testa.nome || currentUser.ragione_sociale;
  const nomeFiliale = testa.filiale || '';
  const conta = typeof contatori !== 'undefined' && contatori ? contatori : {};
  const titoloPagina = typeof intestazione !== 'undefined' && intestazione ? intestazione : '';
  const tornaA = typeof indietro !== 'undefined' && indietro ? indietro : '';
  // La home è /distributore (anche con la barra finale): lì niente striscia e niente avvisi a comparsa. Lo script la riconosce dal percorso, uguale.
  const eHome = perc.replace(/\/+$/, '') === '/distributore';
  const daConfermare = Number(conta.daRispondere) || 0;
%>
<header class="banco-testa" data-banco-testa data-ditta="<%= fmt.nomeCommerciale(nomeDitta) %>">
  <div class="banco-identita">
    <div class="banco-ditta"><%= nomeDitta %></div>
    <% if (nomeFiliale) { %><div class="banco-filiale"><%= nomeFiliale %></div><% } %>
  </div>

  <nav class="banco-menu" aria-label="Sezioni del banco">
    <a class="banco-voce<%= sezione === 'banco' ? ' attiva' : '' %>" href="/distributore"<%- sezione === 'banco' ? ' aria-current="page"' : '' %>>
      <span class="banco-voce-ico"><%- iconaHome %></span>Banco
      <%# Sempre nella pagina (nascosto a zero): lo script lo accende quando arriva una richiesta, senza ricaricare. %>
      <span class="banco-voce-pallino banco-voce-pallino-ordini" data-banco-pallino aria-label="<%= daConfermare %> da confermare"<%- daConfermare > 0 ? '' : ' hidden' %>><%= daConfermare %></span>
    </a>
    <a class="banco-voce<%= sezione === 'clienti' ? ' attiva' : '' %>" href="/distributore/clienti"<%- sezione === 'clienti' ? ' aria-current="page"' : '' %>>
      <span class="banco-voce-ico"><%- iconaClienti %></span>Clienti
      <% if (conta.daApprovare > 0) { %>
        <span class="banco-voce-pallino" aria-label="<%= conta.daApprovare %> da approvare"><%= conta.daApprovare %></span>
      <% } %>
    </a>
    <a class="banco-voce<%= sezione === 'storico' ? ' attiva' : '' %>" href="/distributore/storico"<%- sezione === 'storico' ? ' aria-current="page"' : '' %>>
      <span class="banco-voce-ico"><%- iconaOrdini %></span>Storico ordini
    </a>
  </nav>

  <div class="banco-azioni">
    <div class="menu-account banco-account" data-menu-account>
      <button class="banco-avatar-btn" type="button" data-menu-apri
              aria-haspopup="true" aria-expanded="false" aria-label="Menu account">
        <%- include('iniziali', { nome: nomeFiliale || nomeDitta, persona: currentUser.ragione_sociale, misura: 40 }) %>
      </button>
      <div class="tendina" data-menu-tendina hidden>
        <div class="tendina-testata">
          <div class="nome"><%= currentUser.ragione_sociale %></div>
          <div class="ruolo">Banco distributore</div>
        </div>
        <a class="voce-solo-stretta" href="/distributore/clienti">Clienti</a>
        <%# Il suono degli avvisi (nuova richiesta, corriere trovato): si sceglie qui, vale su questo browser (localStorage, default sì). %>
        <button type="button" class="voce-tema" data-suoni-voce aria-pressed="true">Suoni notifiche: <span data-suoni-stato>sì</span></button>
        <%# Il browser chiede il permesso delle notifiche del computer solo dopo un clic: la voce c'è finché il permesso non è stato dato o negato (lo script la nasconde se non serve). %>
        <button type="button" class="voce-tema" data-notifiche-sistema hidden>Attiva le notifiche del computer</button>
        <form method="POST" action="/logout">
          <button type="submit" class="voce-esci">Esci</button>
        </form>
      </div>
    </div>
  </div>
</header>

<%# Striscia arancio e icone degli avvisi a comparsa: solo fuori dalla home. %>
<% if (!eHome) { %><%- include('banco_avviso', { daConfermare, primaScadeSec: typeof primaScadeSec !== 'undefined' ? primaScadeSec : null }) %><% } %>

<% if (titoloPagina || tornaA) { %>
  <div class="banco-titolo">
    <% if (tornaA) { %><a class="banco-indietro" href="<%= tornaA %>" aria-label="Indietro"><%- iconaIndietro %></a><% } %>
    <% if (titoloPagina) { %><h1 class="banco-titolo-testo"><%= titoloPagina %></h1><% } %>
  </div>
<% } %>
