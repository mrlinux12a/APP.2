    </a>
    <a href="/ordini" class="<%= attivo === 'ordini' ? 'attivo' : '' %>"><span class="ico">📦</span>Stato ordini</a>
  </div>
</nav>
<div hidden data-geo data-consenso="<%= (typeof geo !== 'undefined' && geo.consenso) ? '1' : '0' %>"><span data-geo-stato></span><span data-geo-badge></span><button data-geo-attiva hidden></button><button data-geo-revoca hidden></button></div>
