<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#12181f">
<title><%= typeof titolo !== 'undefined' ? titolo : 'Ordini Minuteria' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&family=Source+Sans+3:wght@400;600&display=swap">
<link rel="stylesheet" href="/style.css">
<script>
  // Applica il tema salvato PRIMA che la pagina si disegni, per evitare un lampo del tema
  // sbagliato. Di default resta scuro (nessun attributo): solo "chiaro" va segnato esplicitamente.
  (function () {
    try {
      var tema = localStorage.getItem('tema');
      if (tema === 'chiaro') document.documentElement.setAttribute('data-tema', 'chiaro');
    } catch (e) {}
  })();
</script>
