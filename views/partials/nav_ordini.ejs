<%#
  Link "Stato ordini" della barra in basso, con l'icona che cambia in base alla fase:
  nessuna -> scatola; richiesta (10 min) -> anello che si svuota + conto alla rovescia;
  consegna -> furgone + minuti all'arrivo; scaduta -> scatola grigia con "!".
  Con DUE O PIÙ attività (statoOrdini.voci) l'icona le alterna ogni 2,5 secondi: un fotogramma per attività, sovrapposti,
  con una dissolvenza incrociata, e sotto i puntini che dicono quante sono. Con 0 o 1 resta l'icona singola di sempre
  (stesso markup, in partials/nav_ordini_fase.ejs). Il tocco porta a /ordini e, con più attività, dritto alla pagina di quella
  mostrata in quel momento (data-href su ogni fotogramma; lo script aggiorna l'href a ogni cambio: niente passaggio da /ordini?voce=,
  che costava un giro in più). data-firma riassume le voci
  (flusso.firmaVoci): una pagina con la striscia (partials/striscia_ordini.ejs) si ricarica se cambia.
  Viene renderizzato anche da solo (GET /nav/stato-ordini) per aggiornarlo senza ricaricare; con
  conScheda (?scheda=1, solo dalla home) segue anche la scheda di stato_home.ejs.
  Lo script in fondo muove i conti alla rovescia: ogni [data-countdown] e [data-arco] legge secondi e durata del contenitore
  [data-secondi] più vicino (la scheda della richiesta, la scheda della home, il fotogramma o il link), non di un conto unico.
  Le consegne non passano da qui: il link o il fotogramma porta [data-eta-sec] (secondi all'arrivo) e i minuti, "In arrivo" (3 minuti o
  meno) e le barre li muove il blocco "Consegna in arrivo" di public/app.js, ogni secondo.
%>
<%
  const attivoNav = typeof attivo !== 'undefined' ? attivo : '';
  const so = (typeof statoOrdini !== 'undefined' && statoOrdini) ? statoOrdini : { fase: 'nessuna' };
  const nonLetti = typeof ordiniNonLetti !== 'undefined' ? ordiniNonLetti : 0;
  const CIRC = 65.97; // 2 * PI * 10.5
  const voci = Array.isArray(so.voci) ? so.voci : [];
  const multi = voci.length >= 2;
%>
<% if (multi) { %>
  <%
    // Letto dal lettore di schermo al posto dei fotogrammi, che cambiano ogni 2,5 secondi: "Stato ordini: 2 attivi. In attesa,
    // 07:42 rimasti. Arriva tra 18 minuti."
    const frase = function (v) {
      if (v.fase === 'richiesta') return 'In attesa, ' + fmt.mmss(v.secondi) + ' rimasti';
      if (v.fase === 'consegna') return v.minuti == null ? 'In consegna' : (v.inArrivo ? 'In arrivo' : 'Arriva tra ' + fmt.durataMinuti(v.minuti));
      return 'Nessuna risposta';
    };
    const etichettaAria = 'Stato ordini: ' + voci.length + ' attivi. ' + voci.map(frase).join('. ') + '.';
    const fasiPresenti = voci.map(function (v) { return v.fase; }).filter(function (f, i, tutte) { return tutte.indexOf(f) === i; });
  %>
<a href="<%= voci[0].href %>" class="nav-ordini multi fase-<%= voci[0].fase %> <%= attivoNav === 'ordini' ? 'attivo' : '' %>" data-fase="<%= voci[0].fase %>" data-fasi="<%= fasiPresenti.join(',') %>" data-attivo="<%= attivoNav %>" data-firma="<%= so.firma || '' %>" aria-label="<%= etichettaAria %>">
  <span class="fotogrammi" aria-hidden="true">
    <% voci.forEach(function (v, i) { %>
      <span class="fotogramma fase-<%= v.fase %><%= i === 0 ? ' attivo' : '' %>" data-voce="<%= v.voce %>" data-href="<%= v.href %>"<% if (v.fase === 'richiesta') { %> data-secondi="<%= v.secondi %>" data-durata="<%= v.durata %>"<% } else if (v.fase === 'consegna' && v.etaSec != null) { %> data-eta-sec="<%= v.etaSec %>"<% } %>>
        <%- include('nav_ordini_fase', { v: v, CIRC: CIRC }) %>
      </span>
    <% }); %>
    <%# Con "riduci movimento" non si alterna: resta fisso il primo fotogramma (il più urgente) e questo numero dice quante sono. %>
    <span class="conteggio"><%= voci.length %></span>
  </span>
  <span class="puntini" aria-hidden="true">
    <% voci.forEach(function (v, i) { %><span class="punto<%= i === 0 ? ' attivo' : '' %>"></span><% }); %>
  </span>
</a>
<% } else { %>
<a href="<%= voci.length === 1 ? voci[0].href : '/ordini' %>" class="nav-ordini fase-<%= so.fase %> <%= attivoNav === 'ordini' ? 'attivo' : '' %>" data-fase="<%= so.fase %>" data-attivo="<%= attivoNav %>" data-firma="<%= so.firma || '' %>"<% if (so.fase === 'richiesta') { %> data-secondi="<%= so.secondi %>" data-durata="<%= so.durata %>"<% } else if (so.fase === 'consegna' && so.etaSec != null) { %> data-eta-sec="<%= so.etaSec %>"<% } %>>
  <% if (so.fase === 'richiesta' || so.fase === 'consegna' || so.fase === 'scaduta') { %>
    <%- include('nav_ordini_fase', { v: so, CIRC: CIRC }) %>
  <% } else { %>
    <span class="ico"><%- iconaOrdini %></span>Stato ordini
    <% if (nonLetti > 0) { %><span class="pallino pallino-azzurro">+<%= nonLetti %></span><% } %>
  <% } %>
</a>
<% } %>
<% if (typeof conScheda !== 'undefined' && conScheda) { %><%- include('stato_home') %><% } %>
<% if (typeof parziale === 'undefined') { %>
<script>
  // Icona "Stato ordini" della barra in basso: conti alla rovescia, alternanza delle attività e aggiornamento senza ricaricare.
  //  · Conti alla rovescia: ogni [data-countdown] e [data-arco] della pagina (icona, scheda della home, schermata di attesa) legge
  //    secondi e durata dal contenitore [data-secondi] più vicino, ognuno con la SUA scadenza (con più richieste insieme non c'è un
  //    conto unico). La fine di un contenitore si fissa la prima volta che lo si vede; un fotogramma nascosto scorre lo stesso.
  //  · Alternanza: con due o più fotogrammi si passa al successivo ogni 2,5 s, in ciclo; si ferma a pagina nascosta e, con "riduci
  //    movimento", non parte (resta fisso il primo, il più urgente).
  //  · Aggiornamento (GET /nav/stato-ordini): ogni 15 s se fra le fasi c'è una richiesta, ogni minuto se c'è solo una consegna. Dopo
  //    aver sostituito il link si riparte dal fotogramma in cui si era, non dal primo, così l'icona non "salta".
  (function () {
    var timer = null, attesa = null, giro = null, inLettura = false;
    var indice = 0; // fotogramma visibile: sopravvive alla sostituzione del link
    var fini = new WeakMap();   // contenitore [data-secondi] -> istante (ms) in cui il suo conto arriva a zero
    var finiti = new WeakSet(); // contenitori già arrivati a zero: si chiede l'aggiornamento una volta sola per ciascuno
    var riduci = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : { matches: false };

    function link() { return document.querySelector('.navbar a.nav-ordini'); }
    function scheda() { return document.querySelector('[data-stato-home]'); }
    function due(n) { return (n < 10 ? '0' : '') + n; }
    function fasi(a) { return (a.getAttribute('data-fasi') || a.getAttribute('data-fase') || '').split(','); }

    function restano(c) {
      var f = fini.get(c);
      if (f === undefined) { f = Date.now() + Number(c.getAttribute('data-secondi')) * 1000; fini.set(c, f); }
      return Math.max(0, Math.round((f - Date.now()) / 1000));
    }
    function tick() {
      var aZero = false;
      document.querySelectorAll('[data-countdown]').forEach(function (el) {
        var c = el.closest('[data-secondi]'); if (!c) return;
        var s = restano(c);
        el.textContent = due(Math.floor(s / 60)) + ':' + due(s % 60);
        if (s === 0 && !finiti.has(c)) { finiti.add(c); aZero = true; }
      });
      document.querySelectorAll('[data-arco]').forEach(function (el) {
        var c = el.closest('[data-secondi]'); if (!c) return;
        var circ = Number(el.getAttribute('data-circ')) || 65.97;
        var durata = Number(c.getAttribute('data-durata')) || 600;
        el.style.strokeDashoffset = (circ * (1 - restano(c) / durata)).toFixed(2);
      });
      // Una richiesta è arrivata a 00:00: il server l'avrà già chiusa o trasformata in ordine, si rilegge subito.
      if (aZero) aggiorna();
    }

    function mostra(i, senzaDissolvenza) {
      var a = link(); if (!a) return;
      if (senzaDissolvenza) a.classList.add('ferma');
      var fotogrammi = a.querySelectorAll('.fotogramma');
      fotogrammi.forEach(function (el, k) { el.classList.toggle('attivo', k === i); });
      // Il tocco porta dritto alla pagina della voce mostrata in questo momento (non da /ordini, che la rimanderebbe lì con un
      // giro in più: le pagine dell'ordine e della richiesta segnano da sé le notifiche come lette).
      var vai = fotogrammi[i] && fotogrammi[i].getAttribute('data-href');
      if (vai) a.setAttribute('href', vai);
      a.querySelectorAll('.puntini .punto').forEach(function (el, k) { el.classList.toggle('attivo', k === i); });
      if (senzaDissolvenza) { void a.offsetWidth; a.classList.remove('ferma'); }
    }
    function fermaGiro() { clearInterval(giro); giro = null; }
    // Un solo setInterval di alternanza alla volta. Se gira già (e i fotogrammi ci sono ancora) lo si lascia andare: ricrearlo a ogni
    // aggiornamento farebbe slittare il cambio di fotogramma.
    function avviaGiro() {
      var a = link();
      var n = a ? a.querySelectorAll('.fotogramma').length : 0;
      if (n < 2) { fermaGiro(); indice = 0; return; }
      indice = indice % n;
      if (riduci.matches) { fermaGiro(); indice = 0; mostra(0, true); return; }
      mostra(indice, true);
      if (document.hidden) { fermaGiro(); return; }
      if (giro) return;
      giro = setInterval(function () {
        var l = link(), m = l ? l.querySelectorAll('.fotogramma').length : 0;
        if (m < 2) return;
        indice = (indice + 1) % m;
        mostra(indice, false);
      }, 2500);
    }

    function avvia() {
      clearInterval(timer); clearTimeout(attesa);
      var a = link(); if (!a) return;
      if (document.querySelector('[data-secondi]')) { tick(); timer = setInterval(tick, 1000); }
      var f = fasi(a);
      if (f.indexOf('richiesta') !== -1) attesa = setTimeout(aggiorna, 15000);
      else if (f.indexOf('consegna') !== -1) attesa = setTimeout(aggiorna, 60000);
      avviaGiro();
    }

    function aggiorna() {
      var a = link(); if (!a) return;
      clearTimeout(attesa);
      if (document.hidden) { attesa = setTimeout(aggiorna, 15000); return; }
      if (inLettura) return;
      inLettura = true;
      var url = '/nav/stato-ordini?attivo=' + encodeURIComponent(a.getAttribute('data-attivo') || '') + (scheda() ? '&scheda=1' : '');
      fetch(url, { credentials: 'same-origin', cache: 'no-store' })
        .then(function (r) { return r.ok ? r.text() : null; })
        .then(function (html) {
          if (html && html.indexOf('nav-ordini') !== -1) {
            var t = document.createElement('div');
            t.innerHTML = html;
            var nuovoLink = t.querySelector('a.nav-ordini'), vecchioLink = link();
            // Una pagina con la striscia (e il dettaglio sotto) resta allineata: se un ordine è passato di fase, ne è arrivato uno o uno è
            // finito, la firma delle voci cambia e si ricarica. Se cambia solo il tempo, la firma è la stessa e basta muovere i timer.
            var striscia = document.querySelector('[data-striscia]');
            if (striscia && nuovoLink && (nuovoLink.getAttribute('data-firma') || '') !== (striscia.getAttribute('data-firma') || '')) {
              location.reload();
              return;
            }
            if (nuovoLink && vecchioLink) vecchioLink.replaceWith(nuovoLink);
            var nuovaScheda = t.querySelector('[data-stato-home]'), vecchiaScheda = scheda();
            if (nuovaScheda && vecchiaScheda) vecchiaScheda.replaceWith(nuovaScheda);
          }
          inLettura = false;
          avvia();
        })
        .catch(function () { inLettura = false; attesa = setTimeout(aggiorna, 30000); });
    }
    // Tornando sulla pagina (tasto indietro che la rimostra com'era, o scheda che torna in primo piano) lo stato può
    // essere cambiato: per esempio con un ordine in consegna si restava a "In consegna" anche con una nuova richiesta
    // in attesa, fino al giro successivo (un minuto). Si rilegge subito.
    window.addEventListener('pageshow', function (e) { if (e.persisted) aggiorna(); });
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) fermaGiro(); else { aggiorna(); avviaGiro(); }
    });
    if (riduci.addEventListener) riduci.addEventListener('change', avviaGiro);
    avvia();
  })();
</script>
<% } %>
