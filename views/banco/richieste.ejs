<%
  // Home del banco: bacheca a tre colonne (Da confermare -> Attesa corriere -> Da preparare), rifatta il 10/11/2026 (branch test/v2-grafica).
  // Il disegno dei tempi (timer a pillola con la barra che si accorcia, "da mm:ss", conto alla rovescia del corriere) parte da qui con i valori del server e lo
  // muove il blocco "Home del banco" di assets/js, con le stesse soglie (data-soglia-* sulla bacheca). Ogni scheda ha `data-lavoro`: la chiave del lavoro, che
  // resta uguale quando la richiesta diventa ordine, con cui il popup "Ispeziona" (blocco "Popup Ispeziona del banco" di assets/js) segue il lavoro da una colonna
  // all'altra. Il codice che si legge è "ORD-" + il numero della richiesta, poi dell'ordine (vedi src/logica/banco/bacheca.js).
  const percentuale = (frazione) => Math.max(0, Math.min(100, Math.round(frazione * 1000) / 10));
%>
<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('../partials/comune/app_head', { titolo }) %>
</head>
<body class="pagina-banco" data-loggato="1" data-auto-refresh="15000" data-versione="<%= JSON.stringify(contatori) %>">

  <%# Intestazione unica del banco, la stessa di tutte le pagine del distributore (anche quelle che passano da partials/comune/appbar.ejs). %>
  <%- include('../partials/banco/banco_testa') %>

  <main class="bacheca" data-bacheca
        data-soglia-urgente="<%= bacheca.urgenteSec %>">
    <div class="bacheca-colonne">

    <%# ---------- Da confermare ---------- %>
    <section class="colonna colonna-conferma" aria-labelledby="col-conferma">
      <div class="colonna-testa">
        <span class="colonna-punto" aria-hidden="true"></span>
        <h2 class="colonna-titolo" id="col-conferma">Da confermare</h2>
        <span class="colonna-conta" aria-label="<%= daConfermare.length %> richieste"><%= daConfermare.length %></span>
      </div>
      <div class="colonna-lista">
        <% if (!daConfermare.length) { %>
          <p class="colonna-vuota">Nessun ordine da confermare.</p>
        <% } %>
        <% daConfermare.forEach(function (r) { %>
          <%# data-chiave: l'identità della scheda, per aggiornare la bacheca sul posto senza ricaricare la pagina (assets/js, "Home del banco"). %>
          <article class="scheda scheda-richiesta<%= r.urgente ? ' urgente' : '' %><%= r.appena ? ' entra' : '' %>"
                   data-chiave="richiesta-<%= r.id %>" data-lavoro="<%= r.lavoro %>" data-richiesta data-secondi="<%= r.secondi %>" data-finestra="<%= finestraSecondi %>">
            <div class="scheda-alto">
              <span class="scheda-codice">#<%= r.codice %></span>
              <%# Timer: parte da quanto manca alla scadenza (secondi del server), mm:ss; "Scaduto" a zero. %>
              <span class="timer-pillola" role="timer">
                <span class="timer-ico" aria-hidden="true"><%- iconaTimer %></span>
                <span data-tempo><%= fmt.mmss(r.secondi) %></span>
              </span>
            </div>
            <div class="timer-barra" aria-hidden="true"><span class="timer-barra-riempita" data-barra style="width: <%= percentuale(r.frazione) %>%"></span></div>

            <div class="scheda-cliente">
              <%- include('../partials/comune/iniziali', { nome: r.cliente_nome, misura: 40 }) %>
              <h3 class="scheda-nome"><%= r.cliente_nome %></h3>
            </div>

            <%- include('../partials/banco/banco_codici', { articoli: r.anteprima, altre: r.altre }) %>

            <%# "Accetta" conferma subito tutto il materiale, senza aprire il popup (se non riesce, il server riporta al dettaglio con l'errore). "Ispeziona" apre il
                popup per controllare prima (senza JS porta alla pagina della richiesta); "Non disponibile" rifiuta subito. %>
            <div class="scheda-azioni scheda-azioni-conferma">
              <a class="btn-banco btn-banco-secondario" href="/distributore/richieste/<%= r.id %>" data-ispeziona="<%= r.lavoro %>"><%- iconaLente %>Ispeziona</a>
              <form method="POST" action="/distributore/richieste/<%= r.id %>/rispondi">
                <input type="hidden" name="azione" value="rifiuta">
                <input type="hidden" name="torna" value="home">
                <button class="btn-banco btn-banco-rifiuta" type="submit">Non disponibile</button>
              </form>
              <form class="azione-principale" method="POST" action="/distributore/richieste/<%= r.id %>/rispondi">
                <input type="hidden" name="azione" value="prezzo_richiesto">
                <input type="hidden" name="torna" value="home">
                <button class="btn-banco btn-banco-accetta" type="submit">Accetta</button>
              </form>
            </div>
          </article>
        <% }); %>
      </div>
    </section>

    <%# ---------- Attesa corriere ---------- %>
    <section class="colonna colonna-corriere" aria-labelledby="col-corriere">
      <div class="colonna-testa">
        <span class="colonna-punto" aria-hidden="true"></span>
        <h2 class="colonna-titolo" id="col-corriere">Attesa corriere</h2>
        <span class="colonna-conta" aria-label="<%= attesaCorriere.length %> richieste"><%= attesaCorriere.length %></span>
      </div>
      <div class="colonna-lista">
        <% if (!attesaCorriere.length) { %>
          <p class="colonna-vuota">Nessun ordine in attesa del corriere.</p>
        <% } %>
        <% attesaCorriere.forEach(function (c) { %>
          <article class="scheda scheda-corriere" data-chiave="corriere-<%= c.id %>" data-lavoro="<%= c.lavoro %>" data-corriere data-trascorsi="<%= c.trascorsi %>">
            <div class="scheda-alto">
              <span class="scheda-codice">#<%= c.codice %></span>
              <%# Il tempo da quando hai confermato, che SALE (mm:ss). %>
              <span class="da-tempo">da <span data-da><%= fmt.tempoTrascorso(c.trascorsi) %></span></span>
            </div>

            <div class="scheda-cliente">
              <%- include('../partials/comune/iniziali', { nome: c.cliente_nome, misura: 40 }) %>
              <h3 class="scheda-nome"><%= c.cliente_nome %></h3>
            </div>

            <%# Riquadro animato: furgone con due onde che pulsano, puntini, barra senza fine. Tutto fermo con "riduci movimento". %>
            <div class="cerca" role="status">
              <div class="cerca-riga">
                <span class="cerca-icona" aria-hidden="true">
                  <span class="cerca-onda"></span><span class="cerca-onda cerca-onda-2"></span>
                  <span class="cerca-furgone"><%- iconaFurgone %></span>
                </span>
                <span class="cerca-testi">
                  <span class="cerca-titolo">Cerco un corriere<span class="puntini" aria-hidden="true"><i></i><i></i><i></i></span></span>
                  <span class="cerca-sotto">In attesa della sua conferma</span>
                </span>
              </div>
              <div class="cerca-barra" aria-hidden="true"><span></span></div>
            </div>

            <div class="scheda-azioni">
              <a class="btn-banco btn-banco-secondario btn-banco-pieno" href="/distributore/richieste/<%= c.id %>" data-ispeziona="<%= c.lavoro %>" aria-label="Ispeziona l'ordine di <%= c.cliente_nome %>"><%- iconaLente %>Ispeziona</a>
            </div>
          </article>
        <% }); %>
      </div>
    </section>

    <%# ---------- Da preparare ---------- %>
    <section class="colonna colonna-preparare" aria-labelledby="col-preparare">
      <div class="colonna-testa">
        <span class="colonna-punto" aria-hidden="true"></span>
        <h2 class="colonna-titolo" id="col-preparare">Da preparare</h2>
        <span class="colonna-conta" aria-label="<%= daPreparare.length %> ordini"><%= daPreparare.length %></span>
      </div>
      <div class="colonna-lista">
        <% if (!daPreparare.length) { %>
          <p class="colonna-vuota">Nessun ordine da preparare.</p>
        <% } %>
        <% daPreparare.forEach(function (o) { %>
          <article class="scheda scheda-ordine" data-chiave="ordine-<%= o.id %>" data-lavoro="<%= o.lavoro %>">
            <div class="ordine-codice-riga">
              <span class="ordine-etichetta"><span class="ordine-etichetta-tit">Ordine</span><span class="ordine-etichetta-cod"><%= o.codice %></span></span>
            </div>
            <h3 class="scheda-nome"><%= o.cliente_nome %></h3>

            <%# Il corriere in arrivo: conto alla rovescia mm:ss (il tempo scritto dal corriere) e barra che si riempie. A zero il riquadro diventa verde pieno
                "Corriere arrivato al banco" (scelta: è la stima, non un segnale vero dell'app corrieri). Senza corriere (modulo spento) non c'è. %>
            <% if (o.arrivo) { %>
              <div class="arrivo<%= o.arrivo.secondi <= 0 ? ' arrivato' : '' %>" data-arrivo data-secondi="<%= o.arrivo.secondi %>" data-totale="<%= o.arrivo.totale %>">
                <div class="arrivo-riga">
                  <span class="arrivo-ico" aria-hidden="true"><%- iconaFurgone %></span>
                  <span class="arrivo-testo" data-arrivo-testo><%= o.arrivo.secondi <= 0 ? 'Corriere arrivato al banco' : 'Corriere in arrivo tra' %></span>
                  <span class="arrivo-punto" aria-hidden="true"></span>
                  <span class="arrivo-tempo" data-arrivo-tempo><%= fmt.mmss(Math.max(0, o.arrivo.secondi)) %></span>
                </div>
                <div class="timer-barra" aria-hidden="true"><span class="timer-barra-riempita" data-barra style="width: <%= percentuale(1 - Math.max(0, o.arrivo.secondi) / o.arrivo.totale) %>%"></span></div>
              </div>
            <% } %>

            <%- include('../partials/banco/banco_codici', { articoli: o.anteprima, altre: o.altre }) %>

            <%# "Ispeziona" apre il popup (senza JS, la pagina dell'ordine) e non tocca l'ordine, che resta in colonna. "Ritirato dal corriere" (il vecchio
                "Preparato", stessa rotta) lo toglie da qui: va "In consegna" nello Storico e il cliente è avvisato (POST .../preparazione, torna alla home). %>
            <div class="scheda-azioni scheda-azioni-ordine">
              <a class="btn-banco btn-banco-secondario" href="/distributore/ordini/<%= o.id %>" data-ispeziona="<%= o.lavoro %>"><%- iconaLente %>Ispeziona</a>
              <form class="azione-principale" method="POST" action="/distributore/ordini/<%= o.id %>/preparazione">
                <input type="hidden" name="torna" value="home">
                <button class="btn-banco btn-banco-ritirato" type="submit"><%- iconaSpunta %>Ritirato dal corriere</button>
              </form>
            </div>
          </article>
        <% }); %>
      </div>
    </section>

    </div>
  </main>

  <%# Il popup "Ispeziona": il pannello è vuoto finché non si apre, lo riempie lo script con GET /distributore/ispeziona/<lavoro> (partials/banco/ispeziona.ejs). %>
  <div class="isp-overlay" data-isp-overlay hidden>
    <div class="isp-pannello" role="dialog" aria-modal="true" aria-labelledby="isp-titolo" tabindex="-1" data-isp-pannello></div>
  </div>

  <%- include('../partials/banco/nav_distributore', { attivo: 'home', contatori }) %>
  <script src="<%= asset('/app.js') %>" defer></script>
</body>
</html>
