<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
</head>
<body data-loggato="1">
  <div class="app app-largo">
    <%- include('partials/appbar', { titolo, intestazione: 'Storico richieste', indietro: '/distributore' }) %>

    <div class="contenuto">
      <% if (!storico.length) { %>
        <div class="vuoto"><span class="emoji"><%- iconaVuotoScatola %></span>Ancora nessuna richiesta chiusa.</div>
      <% } else { %>
        <div class="card card-fitta">
          <% storico.forEach(function (r) { %>
            <a class="riga-lista" href="/distributore/richieste/<%= r.id %>">
              <span class="icona"><%- r.stato === 'ordinata' && r.esito === 'confermato' ? iconaOrdini : iconaDocumento %></span>
              <span class="corpo">
                <span class="etichetta">Richiesta #<%= r.id %> — <%= r.cliente_nome %></span>
                <span class="dettaglio"><%= r.pezzi %> pz · <%= fmt.dataOra(r.creato_il) %></span>
              </span>
              <% const attesaCorriere = r.esito === 'confermato' && r.corriere_stato === 'in_attesa'; %>
              <% const senzaCorriere = r.esito === 'confermato' && r.corriere_stato === 'scaduto'; %>
              <span class="stato-badge stato-<%= attesaCorriere ? 'in_attesa' : (senzaCorriere ? 'scaduto' : r.esito) %>">
                <%= attesaCorriere ? 'In attesa del corriere' : (senzaCorriere ? 'Nessun corriere' : (r.esito === 'confermato' ? 'Confermata' : (r.esito === 'non_disponibile' ? 'Non disponibile' : (r.esito === 'scaduto' ? 'Non risposta' : 'In attesa')))) %>
              </span>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('partials/nav_distributore', { attivo: '' }) %>
  <script src="/app.js" defer></script>
</body>
</html>
