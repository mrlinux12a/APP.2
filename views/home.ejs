<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
</head>
<body data-loggato="1">
  <div class="app">
    <%- include('partials/appbar', { titolo, intestazione: 'Catalogo', indietro: null }) %>

    <div class="contenuto home-cliente">
      <%# Richiesta in attesa o ordine in consegna (vuota se non c'è niente): stessi dati dell'icona in basso. %>
      <%- include('partials/stato_home') %>

      <%# Resta fisso sotto l'appbar quando si scorre. %>
      <div class="ricerca-fissa">
        <h1 class="domanda">Cosa ti serve?</h1>
        <form class="barra-ricerca barra-home" method="GET" action="/cerca">
          <span class="lente"><%- iconaLente %></span>
          <input type="search" name="q" enterkeyhint="search" data-ricerca
                 placeholder="Nome o misura: valv 3/4"
                 aria-label="Cerca un pezzo"
                 autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
          <%# Non ancora attivo: foto e codice a barre arriveranno dopo. Nessun handler, solo il segnaposto. %>
          <button type="button" class="btn-inquadra" disabled aria-disabled="true"
                  aria-label="Cerca con una foto o il codice a barre" title="Presto disponibile"><%- iconaInquadra %></button>
          <button type="submit" class="btn-cerca">Cerca</button>
        </form>
      </div>

      <div id="risultati">
        <div class="griglia-categorie">
          <%# Una parola da 15+ lettere ("Condizionamento") non sta in 110px a 13.5px: scheda con corpo ridotto, invece di spezzarla. %>
          <% const parolaLunga = (nome) => nome.split(/\s+/).some((p) => p.length > 14); %>
          <% inEvidenza.concat(altre).forEach(function (m) { %>
            <a class="cat<%= parolaLunga(m.nome) ? ' cat-lunga' : '' %>" href="/categoria/<%= m.slug %>">
              <span class="cat-ico"><%- iconaCategoria(m.slug) %></span>
              <span class="nome"><%= m.nome %></span>
            </a>
          <% }); %>
          <a class="cat" href="/con-foto">
            <span class="cat-ico"><%- iconaCatalogo %></span>
            <span class="nome">Elementi con foto</span>
          </a>
        </div>

        <p class="nota">
          I prezzi in app sono IVA esclusa. Paghi quando mandi la richiesta; il banco conferma la disponibilità
          e, se nessuno conferma, il pagamento ti viene rimborsato.
        </p>
      </div>
    </div>

    <div class="barra-carrello" data-barra-carrello <%= carrelloPezzi ? '' : 'hidden' %>>
      <div class="interno">
        <div class="barra-carrello-testo">
          <span data-pendenti-wrap hidden><strong data-pendenti>0</strong> selezionati</span>
          <span data-sep-pendenti hidden> · </span>
          <span data-carrello-wrap <%= carrelloPezzi ? '' : 'hidden' %>><strong data-carrello-conta><%= carrelloPezzi %></strong> nel carrello</span>
          <span data-carrello-vuoto <%= carrelloPezzi ? 'hidden' : '' %>>Nessun pezzo nel carrello</span>
        </div>
        <div style="display:flex;gap:8px;align-items:center;">
          <button class="btn btn-primary" type="button" data-aggiungi-tutti disabled>Aggiungi</button>
          <a class="btn btn-chiaro" href="/carrello" data-vai-carrello <%= carrelloPezzi ? '' : 'hidden' %>>Vai al carrello</a>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/nav', { attivo: 'home' }) %>
  <script src="<%= asset('/app.js') %>" defer></script>
</body>
</html>
