<%
  // "Password dimenticata?" (GET/POST /password-dimenticata). Due stati: il modulo (nome utente o email) e, dopo l'invio, la conferma: SEMPRE la stessa
  // frase, che l'account esista o no (niente elenco degli iscritti). Parametri: stato ('modulo' | 'inviata' | 'troppe'), errore, identificativo.
  const stato = locals.stato || 'modulo';
%>
<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo: 'Password dimenticata' }) %>
</head>
<body data-loggato="0">
  <main class="acc">
    <header class="acc-testata">
      <span class="acc-icona" aria-hidden="true"><%- iconaLucchetto %></span>
      <div class="acc-occhiello">Ordini Minuteria</div>
      <h1 class="acc-titolo">Password dimenticata?</h1>
      <% if (stato === 'modulo') { %>
        <p class="acc-sotto">Scrivi il tuo nome utente o la tua email: ti mandiamo un link per scegliere una nuova password.</p>
      <% } %>
    </header>

    <% if (stato === 'inviata') { %>
      <div class="acc-avviso" role="status">
        <strong>Controlla la posta.</strong> Se c'è un account con questi dati, abbiamo mandato un'email con il link per scegliere una nuova password.
        Il link vale <%= minutiValidita %> minuti. Non la trovi? Guarda anche nella posta indesiderata.
      </div>
      <p class="acc-fondo"><a href="/login">‹ Torna all'accesso</a></p>
    <% } else if (stato === 'troppe') { %>
      <div class="errore" role="alert">Hai fatto troppe richieste. Riprova fra un'ora, oppure scrivi al supporto.</div>
      <p class="acc-fondo"><a href="/login">‹ Torna all'accesso</a></p>
    <% } else { %>
      <% if (locals.errore) { %><div class="errore" role="alert"><%= errore %></div><% } %>
      <form method="POST" action="/password-dimenticata">
        <%- include('partials/acc_campo', {
          id: 'identificativo', etichetta: 'Nome utente o email', valore: locals.identificativo || '',
          attributi: { autocomplete: 'username', autocapitalize: 'none', autocorrect: 'off', spellcheck: 'false', required: true, maxlength: 200 },
        }) %>
        <button class="acc-btn" type="submit">Mandami il link</button>
      </form>
      <p class="acc-fondo"><a href="/login">‹ Torna all'accesso</a></p>
    <% } %>
  </main>
  <script src="<%= asset('/app.js') %>" defer></script>
</body>
</html>
