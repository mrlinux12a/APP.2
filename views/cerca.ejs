<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
</head>
<body data-loggato="1">
  <div class="app app-categoria">
    <%- include('partials/appbar', { titolo, intestazione: 'Cerca prodotti', indietro: '/home' }) %>

    <div class="contenuto" style="padding-bottom:0;">
      <%- include('partials/barra_ricerca', {
            azione: '/cerca',
            q,
            ambito: { diametro: diametro || '', materiale: materiale || '' },
            segnaposto: 'Scrivi anche solo una parte, es. "valv"'
          }) %>
    </div>

    <div class="contenuto" style="padding-top:0;">
      <%# Righe compatte come nella categoria (−/+ salva subito nel carrello, niente "Aggiungi"): le disegna app.js anche per la ricerca live. %>
      <div id="risultati" data-righe-compatte
           data-carrello="<%= JSON.stringify(carrello || {}) %>"
           data-pezzi="<%= carrelloPezzi || 0 %>"
           data-icona-vuota="<%= iconaOrdini %>">
        <% if (!q) { %>
          <div class="vuoto"><span class="emoji"><%- iconaLente %></span>Scrivi anche solo un pezzo di parola: cercando &laquo;valv&raquo; trovi tutte le valvole.</div>
        <% } else if (!risultati.length) { %>
          <div class="vuoto"><span class="emoji"><%- iconaVuotoRicerca %></span>Nessun prodotto trovato per &laquo;<%= q %>&raquo;.</div>
        <% } else { %>
          <div class="card card-fitta elenco-righe">
            <% risultati.forEach(function (p) { %>
              <%- include('partials/prodotto_riga', { p, carrello }) %>
            <% }); %>
          </div>
          <% if (troncato) { %><p class="nota nota-troncato" data-troncato>Mostrati i primi risultati: scrivi qualcosa in più per restringere la ricerca.</p><% } %>
        <% } %>
      </div>
    </div>

    <!-- Barra sopra la navbar: pezzi nel carrello e "Vai al carrello"; compare solo con almeno un pezzo -->
    <div class="barra-vai" data-barra-vai <%= carrelloPezzi ? '' : 'hidden' %>>
      <a class="barra-vai-link" href="/carrello">
        <span class="bv-pezzi" data-barra-pezzi><%= carrelloPezzi || 0 %> <%= carrelloPezzi === 1 ? 'pezzo' : 'pezzi' %></span>
        <span class="bv-pillola">Vai al carrello <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </a>
    </div>
  </div>

  <%- include('partials/nav', { attivo: 'catalogo' }) %>
  <script src="<%= asset('/app.js') %>" defer></script>
</body>
</html>
