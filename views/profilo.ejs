<%
  // Pagina di sola lettura: ogni dato mancante nasconde la sua voce invece di lasciarla vuota.
  const pulito = (v) => String(v == null ? '' : v).trim();

  const tipo = tipi[cliente.tipo_soggetto] || '';
  const referente = pulito(cliente.referente);
  // Un solo distributore: lo sceglie anagrafiche.distributoreDiRiferimento (la route lo passa come `distributore`),
  // la stessa regola del menu del profilo.

  const piva = pulito(cliente.partita_iva);
  const cf = pulito(cliente.codice_fiscale);
  const sdi = pulito(cliente.sdi_pec);
  const viaSede = pulito(cliente.indirizzo);
  const provincia = pulito(cliente.provincia);
  const cittaSede = [pulito(cliente.cap), pulito(cliente.citta), provincia ? '(' + provincia + ')' : ''].filter(Boolean).join(' ');
  const telefono = pulito(cliente.telefono);
  const email = pulito(cliente.email);
%>
<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
</head>
<body data-loggato="1">
  <div class="app app-anagrafica">
    <%- include('partials/appbar', { titolo, intestazione: 'La mia anagrafica', indietro: '/home' }) %>

    <div class="contenuto anag">
      <section class="an-scheda an-nome">
        <%- include('partials/iniziali', { nome: cliente.ragione_sociale, persona: cliente.referente, misura: 56 }) %>
        <div class="an-nome-testi">
          <div class="an-ragione"><%= cliente.ragione_sociale %></div>
          <% if (referente || tipo) { %>
            <div class="an-sotto"><%= [referente, tipo].filter(Boolean).join(' · ') %></div>
          <% } %>
        </div>
      </section>

      <% if (cliente.stato_anagrafica === 'in_attesa') { %>
        <div class="avviso avviso-attenzione">
          Nessun distributore ti ha ancora approvato: puoi sfogliare il catalogo, ma non
          inviare richieste di disponibilità.
        </div>
      <% } %>

      <% if (distributore) { %>
        <section class="an-scheda">
          <h2 class="an-titolo">Distributore di riferimento</h2>
          <div class="an-riga">
            <span class="an-icona an-icona-blu" aria-hidden="true"><%- iconaNegozio %></span>
            <div class="an-testi">
              <div class="an-distributore"><%= distributore.distributore %></div>
              <% if (distributore.stato === 'approvato' && distributore.codice_cliente) { %>
                <div class="an-dettaglio">Codice cliente <strong><%= distributore.codice_cliente %></strong></div>
              <% } %>
            </div>
          </div>
        </section>
      <% } %>

      <section class="an-scheda">
        <h2 class="an-titolo">Dati di fatturazione</h2>

        <div class="an-riga">
          <span class="an-icona" aria-hidden="true"><%- iconaAzienda %></span>
          <div class="an-testi">
            <div class="an-etichetta">Ragione sociale</div>
            <div class="an-valore"><%= cliente.ragione_sociale %></div>
            <% if (tipo || referente) { %>
              <div class="an-dettaglio"><%= [tipo, referente ? 'referente ' + referente : ''].filter(Boolean).join(' · ') %></div>
            <% } %>
          </div>
        </div>

        <% if (piva || cf || sdi) { %>
          <div class="an-riga an-fiscali">
            <% if (piva) { %>
              <div class="an-testi">
                <div class="an-etichetta">Partita IVA</div>
                <div class="an-valore an-cifre"><%= piva %></div>
              </div>
            <% } %>
            <% if (cf) { %>
              <div class="an-testi">
                <div class="an-etichetta">Codice fiscale</div>
                <div class="an-valore an-cifre"><%= cf %></div>
              </div>
            <% } %>
            <% if (sdi) { %>
              <%# Una PEC è lunga: occupa tutta la riga invece di andare a capo in mezza colonna. %>
              <div class="an-testi<%= sdi.indexOf('@') !== -1 ? ' an-largo' : '' %>">
                <div class="an-etichetta">Codice SDI / PEC</div>
                <div class="an-valore an-cifre"><%= sdi %></div>
              </div>
            <% } %>
          </div>
        <% } %>

        <% if (viaSede || cittaSede) { %>
          <div class="an-riga">
            <span class="an-icona" aria-hidden="true"><%- iconaPosizione %></span>
            <div class="an-testi">
              <div class="an-etichetta">Sede legale</div>
              <% if (viaSede) { %><div class="an-valore"><%= viaSede %></div><% } %>
              <% if (cittaSede) { %><div class="an-dettaglio"><%= cittaSede %></div><% } %>
            </div>
          </div>
        <% } %>
      </section>

      <% if (telefono || email) { %>
        <section class="an-scheda">
          <h2 class="an-titolo">Contatti</h2>
          <% if (telefono) { %>
            <div class="an-riga">
              <span class="an-icona" aria-hidden="true"><%- iconaTelefono %></span>
              <div class="an-testi">
                <div class="an-etichetta">Telefono</div>
                <div class="an-valore"><%= telefono %></div>
              </div>
            </div>
          <% } %>
          <% if (email) { %>
            <div class="an-riga">
              <span class="an-icona" aria-hidden="true"><%- iconaEmail %></span>
              <div class="an-testi">
                <div class="an-etichetta">Email</div>
                <div class="an-valore"><%= email %></div>
              </div>
            </div>
          <% } %>
        </section>
      <% } %>

      <%# Accesso: nome utente e cambio della password (modulo in un <details>: senza JavaScript si apre da sé e con errori resta aperto). Dopo il cambio le altre
          sessioni e l'app dovranno accedere di nuovo (src/password_account.js). %>
      <%
        const errP = locals.erroriPassword || {};
        const haErroriPassword = Object.keys(errP).length > 0;
      %>
      <section class="an-scheda an-accesso" id="accesso">
        <h2 class="an-titolo">Accesso</h2>
        <div class="an-riga">
          <span class="an-icona" aria-hidden="true"><%- iconaPersona %></span>
          <div class="an-testi">
            <div class="an-etichetta">Nome utente</div>
            <div class="an-valore"><%= cliente.username %></div>
          </div>
        </div>
        <div class="an-riga">
          <span class="an-icona" aria-hidden="true"><%- iconaLucchetto %></span>
          <div class="an-testi">
            <div class="an-etichetta">Password</div>
            <div class="an-valore an-punti" aria-label="Password nascosta">••••••••••</div>
          </div>
        </div>
        <% if (locals.passwordCambiata) { %><p class="an-ok" role="status">Password cambiata. Le altre sessioni e l'app dovranno accedere di nuovo.</p><% } %>
        <details class="an-pw"<%= haErroriPassword ? ' open' : '' %>>
          <summary>Cambia password</summary>
          <form method="POST" action="/profilo/password" novalidate>
            <%- include('partials/acc_campo', { id: 'attuale', etichetta: 'Password attuale', tipo: 'password', sbagliato: !!errP.attuale, hint: errP.attuale || '',
                 attributi: { autocomplete: 'current-password', required: true, maxlength: 100 } }) %>
            <%- include('partials/acc_campo', { id: 'nuova', etichetta: 'Nuova password', tipo: 'password', sbagliato: !!errP.nuova, hint: errP.nuova || 'Almeno 8 caratteri.',
                 attributi: { autocomplete: 'new-password', required: true, maxlength: 100 } }) %>
            <%- include('partials/acc_campo', { id: 'ripeti', etichetta: 'Ripeti la nuova password', tipo: 'password', sbagliato: !!errP.ripeti, hint: errP.ripeti || '',
                 attributi: { autocomplete: 'new-password', required: true, maxlength: 100 } }) %>
            <button class="acc-btn an-pw-salva" type="submit">Salva la nuova password</button>
          </form>
        </details>
      </section>

      <%# Sul telefono: installare l'app (la scheda compare solo se si può) e attivare gli avvisi del browser (public/app.js). %>
      <section class="an-scheda an-telefono" data-telefono>
        <h2 class="an-titolo">Sul telefono</h2>
        <%- include('partials/installa', { variante: 'profilo' }) %>
        <div class="an-riga an-notifiche" data-notifiche-scheda>
          <span class="an-icona an-icona-blu" aria-hidden="true"><%- iconaNotifiche %></span>
          <div class="an-testi">
            <div class="an-valore">Avvisi sul telefono</div>
            <div class="an-dettaglio" data-notifiche-stato>Ricevi un avviso quando un banco risponde alla tua richiesta.</div>
          </div>
          <button type="button" class="ab-switch" role="switch" aria-checked="false" aria-label="Avvisi sul telefono" data-abilita-notifiche><span class="ab-switch-pallino"></span></button>
        </div>
      </section>

      <%# Eliminare l'account: una pagina a parte spiega cosa succede e chiede la password (GET/POST /profilo/elimina). %>
      <section class="an-scheda an-pericolo">
        <h2 class="an-titolo">Elimina account</h2>
        <p class="an-testo">Se non vuoi più usare Minuteria puoi eliminare il tuo account. Ordini e ricevute già emessi restano per obbligo di legge.</p>
        <a class="an-elimina" href="/profilo/elimina">Elimina account…</a>
      </section>

      <p class="an-nota">
        <span class="an-nota-icona" aria-hidden="true"><%- iconaInfo %></span>
        <span>Per correggere i dati scrivi al tuo distributore o all'agente.</span>
      </p>
    </div>
  </div>

  <%- include('partials/nav', { attivo: '' }) %>
  <script src="<%= asset('/app.js') %>" defer></script>
</body>
</html>
