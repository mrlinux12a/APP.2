<%
  // Pagina di un cliente del banco. Tre stati (rapporto.stato):
  //  · da verificare: a destra il riquadro "È un tuo cliente?" (colonne 1,5 : 1);
  //  · rifiutato: a destra il pulsante per ripensarci (come sopra);
  //  · approvato (22/10/2026, per dare spazio agli ordini): i dati del cliente stanno in UNA barra bianca sotto l'intestazione del banco (freccia,
  //    iniziali, nome, "cod. cliente · P.IVA", telefono ed email come pillole) e nel pannello "Dati cliente", chiuso all'arrivo; sotto, a tutta
  //    larghezza, "Materiale ordinato" (tutti gli ordini fatti a questo banco, col materiale a prezzi IVA inclusa), che scorre con la PAGINA.
  // Una voce senza dato non si disegna. Gli sconti concordati non stanno più qui (la rotta POST .../sconti c'è ancora, senza modulo).
  const stato = rapporto.stato;
  const eApprovato = stato === 'approvato';
  const eRifiutato = stato === 'rifiutato';
  const eDaVerificare = !eApprovato && !eRifiutato;
  const [testoStato, coloreStato] = eApprovato ? ['Approvato', 'verde'] : eRifiutato ? ['Rifiutato', 'rosso'] : ['Da verificare', 'arancio'];
  const tonoCerchio = eApprovato ? '' : eRifiutato ? 'grigio' : 'arancio';

  const sottotitolo = [
    tipi[cliente.tipo_soggetto],
    cliente.referente ? 'referente ' + cliente.referente : '',
    'iscritto il ' + fmt.dataOraRoma(rapporto.richiesto_il),
  ].filter(Boolean).join(' · ');

  // Sede legale: via in grassetto e, sotto, CAP, città e provincia. L'indirizzo di consegna è una stringa sola
  // ("Via Puggia 22/3, 16131 Genova (GE)"): la via è quel che sta prima della prima virgola. La città resta com'è salvata.
  const sede = {
    via: String(cliente.indirizzo || '').trim(),
    zona: [cliente.cap, cliente.citta, cliente.provincia ? '(' + cliente.provincia + ')' : ''].filter(Boolean).join(' '),
  };
  const testoConsegna = String(cliente.indirizzo_consegna || '').trim();
  const virgola = testoConsegna.indexOf(',');
  const consegna = virgola > 0
    ? { via: testoConsegna.slice(0, virgola).trim(), zona: testoConsegna.slice(virgola + 1).trim() }
    : { via: testoConsegna, zona: '' };
  const haSede = !!(sede.via || sede.zona);
  const haConsegna = !!(consegna.via || consegna.zona);
  const fiscali = [
    ['Partita IVA', cliente.partita_iva],
    ['Codice fiscale', cliente.codice_fiscale],
    ['Codice SDI / PEC', cliente.sdi_pec],
  ].filter(function (x) { return x[1]; });
  const telefono = String(cliente.telefono || '').trim();
  const email = String(cliente.email || '').trim();
  // Riga sotto il nome nella barra dell'approvato: tipo · cod. cliente · P.IVA (le voci vuote non si scrivono).
  const sottotitoloBarra = [
    tipi[cliente.tipo_soggetto],
    rapporto.codice_cliente ? 'cod. cliente ' + rapporto.codice_cliente : '',
    cliente.partita_iva ? 'P.IVA ' + cliente.partita_iva : '',
  ].filter(Boolean).join(' · ');
%>
<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo, senzaTelefoni: true }) %>
</head>
<body class="pagina-clienti" data-loggato="1">

  <%# Intestazione unica del banco, con la scheda "Clienti" attiva (la sceglie il percorso /distributore/clienti/...). %>
  <%- include('partials/banco_testa') %>

  <%# ---------- Approvato: la barra del cliente (una riga) e il pannello "Dati cliente" ----------
       Sotto l'intestazione del banco, a tutta larghezza. Il <details> sta DOPO la riga ma il suo <summary> (il pulsante "Dati cliente ▾") è posizionato dal CSS
       in fondo a destra della riga da 900px in su (sotto, va a tutta larghezza sotto le pillole): così il pannello si apre sotto la barra e spinge giù la pagina,
       senza JS. Dentro c'è tutto ciò che prima stava nella colonna di sinistra. %>
  <% if (eApprovato) { %>
    <div class="cli-barra" role="region" aria-label="Cliente">
      <div class="cli-barra-riga">
        <a class="cli-indietro-tondo" href="/distributore/clienti" aria-label="Torna ai clienti"><%- iconaIndietro %></a>
        <%- include('partials/iniziali', { nome: cliente.ragione_sociale, persona: cliente.referente, misura: 40, tono: tonoCerchio }) %>
        <div class="cli-barra-testi">
          <div class="cli-intesta-riga">
            <h1 class="cli-nome-grande"><%= cliente.ragione_sociale %></h1>
            <span class="cli-etichetta cli-etichetta-<%= coloreStato %>"><%= testoStato %></span>
          </div>
          <% if (sottotitoloBarra) { %><p class="cli-barra-sotto"><%= sottotitoloBarra %></p><% } %>
        </div>
        <% if (telefono || email) { %>
          <div class="cli-barra-pillole">
            <% if (telefono) { %>
              <%# Il numero non è un collegamento (richiesta esplicita del 21/10/2026): una pillola come l'altra, ma senza tocco né effetto al passaggio. %>
              <span class="cli-pill cli-pill-fissa"><span class="cli-pill-ico" aria-hidden="true"><%- iconaTelefono %></span><span class="cli-pill-testo cli-cifre"><%= telefono %></span></span>
            <% } %>
            <% if (email) { %>
              <a class="cli-pill" href="mailto:<%= email %>"><span class="cli-pill-ico" aria-hidden="true"><%- iconaEmail %></span><span class="cli-pill-testo"><%= email %></span></a>
            <% } %>
          </div>
        <% } %>
      </div>

      <details class="cli-dati-det">
        <summary class="cli-dati-btn">Dati cliente <span class="cli-dati-chev" aria-hidden="true"><%- iconaGiu %></span></summary>
        <div class="cli-pannello">
          <% if (fiscali.length) { %>
            <section class="cli-blocco" aria-labelledby="cli-fatturazione">
              <h2 class="cli-blocco-titolo" id="cli-fatturazione">Dati di fatturazione</h2>
              <dl class="cli-dati cli-dati-auto">
                <% fiscali.forEach(function (x) { %>
                  <div class="cli-dato">
                    <dt class="cli-dato-eti"><%= x[0] %></dt>
                    <dd class="cli-dato-val cli-cifre"><%= x[1] %></dd>
                  </div>
                <% }); %>
              </dl>
              <% if (cliente.partita_iva) { %>
                <a class="cli-vies" href="https://ec.europa.eu/taxation_customs/vies/#/vat-validation"
                   target="_blank" rel="noopener">Controlla su VIES <%- iconaEsterno %></a>
              <% } %>
            </section>
          <% } %>

          <% if (haSede || haConsegna) { %>
            <section class="cli-blocco" aria-labelledby="cli-indirizzi">
              <h2 class="cli-blocco-titolo" id="cli-indirizzi">Indirizzi</h2>
              <dl class="cli-dati cli-dati-auto">
                <% if (haSede) { %>
                  <div class="cli-dato">
                    <dt class="cli-dato-eti">Sede legale</dt>
                    <% if (sede.via) { %><dd class="cli-dato-val"><%= sede.via %></dd><% } %>
                    <% if (sede.zona) { %><dd class="cli-dato-det"><%= sede.zona %></dd><% } %>
                  </div>
                <% } %>
                <% if (haConsegna) { %>
                  <div class="cli-dato">
                    <dt class="cli-dato-eti">Consegna abituale</dt>
                    <% if (consegna.via) { %><dd class="cli-dato-val"><%= consegna.via %></dd><% } %>
                    <% if (consegna.zona) { %><dd class="cli-dato-det"><%= consegna.zona %></dd><% } %>
                  </div>
                <% } %>
              </dl>
            </section>
          <% } %>

          <%# Cliente approvato: codice, referente, date e note interne. Referente e data d'iscrizione stavano sotto il nome (la riga "tipo · referente · iscritto il"):
              ora che sotto il nome c'è "cod. cliente · P.IVA" si leggono qui, così nessun dato sparisce. %>
          <section class="cli-blocco" aria-labelledby="cli-titolo-approvato">
            <h2 class="cli-blocco-titolo" id="cli-titolo-approvato">Cliente approvato</h2>
            <dl class="cli-dati cli-dati-auto">
              <% if (rapporto.codice_cliente) { %>
                <div class="cli-dato">
                  <dt class="cli-dato-eti">Codice cliente</dt>
                  <dd class="cli-dato-val cli-cifre"><%= rapporto.codice_cliente %></dd>
                </div>
              <% } %>
              <% if (cliente.referente) { %>
                <div class="cli-dato">
                  <dt class="cli-dato-eti">Referente</dt>
                  <dd class="cli-dato-val"><%= cliente.referente %></dd>
                </div>
              <% } %>
              <div class="cli-dato">
                <dt class="cli-dato-eti">Iscritto il</dt>
                <dd class="cli-dato-val"><%= fmt.dataOraRoma(rapporto.richiesto_il) %></dd>
              </div>
              <% if (rapporto.deciso_il) { %>
                <div class="cli-dato">
                  <dt class="cli-dato-eti">Approvato il</dt>
                  <dd class="cli-dato-val"><%= fmt.dataOraRoma(rapporto.deciso_il) %></dd>
                </div>
              <% } %>
              <% if (rapporto.note) { %>
                <div class="cli-dato cli-dato-largo">
                  <dt class="cli-dato-eti">Note interne</dt>
                  <dd class="cli-dato-val cli-dato-note"><%= rapporto.note %></dd>
                </div>
              <% } %>
            </dl>
            <p class="cli-nota">Può inviarti richieste di disponibilità.</p>
          </section>
        </div>
      </details>
    </div>
  <% } %>

  <main class="cli-pagina<%= eApprovato ? ' cli-pagina-larga' : '' %>">
    <%# Gli altri stati hanno la riga "← Clienti" sopra e la testata con le iniziali da 56. L'approvato ha la sua barra qui sopra. %>
    <% if (!eApprovato) { %>
      <a class="cli-indietro" href="/distributore/clienti"><%- iconaIndietro %>Clienti</a>

      <div class="cli-intesta">
        <%- include('partials/iniziali', { nome: cliente.ragione_sociale, persona: cliente.referente, misura: 56, tono: tonoCerchio }) %>
        <div class="cli-intesta-testi">
          <div class="cli-intesta-riga">
            <h1 class="cli-nome-grande"><%= cliente.ragione_sociale %></h1>
            <span class="cli-etichetta cli-etichetta-<%= coloreStato %>"><%= testoStato %></span>
          </div>
          <p class="cli-intesta-sotto"><%= sottotitolo %></p>
        </div>
      </div>
    <% } %>

    <div class="cli-layout<%= eApprovato ? ' cli-layout-approvato' : ' cli-layout-decisione' %>">

      <%# ---------- Sinistra: i dati dell'anagrafica (da verificare e rifiutato; l'approvato li ha nella barra) ---------- %>
      <% if (!eApprovato) { %>
      <div class="cli-colonna">
        <% if (fiscali.length || haSede || haConsegna) { %>
          <section class="cli-scheda" aria-labelledby="cli-fatturazione">
            <h2 class="cli-scheda-titolo" id="cli-fatturazione">Dati di fatturazione</h2>

            <% if (fiscali.length) { %>
              <dl class="cli-dati cli-dati-3">
                <% fiscali.forEach(function (x) { %>
                  <div class="cli-dato">
                    <dt class="cli-dato-eti"><%= x[0] %></dt>
                    <dd class="cli-dato-val cli-cifre"><%= x[1] %></dd>
                  </div>
                <% }); %>
              </dl>
              <% if (cliente.partita_iva) { %>
                <a class="cli-vies" href="https://ec.europa.eu/taxation_customs/vies/#/vat-validation"
                   target="_blank" rel="noopener">Controlla su VIES <%- iconaEsterno %></a>
              <% } %>
            <% } %>

            <% if (fiscali.length && (haSede || haConsegna)) { %><hr class="cli-linea"><% } %>

            <% if (haSede || haConsegna) { %>
              <dl class="cli-dati cli-dati-2">
                <% if (haSede) { %>
                  <div class="cli-dato">
                    <dt class="cli-dato-eti">Sede legale</dt>
                    <% if (sede.via) { %><dd class="cli-dato-val"><%= sede.via %></dd><% } %>
                    <% if (sede.zona) { %><dd class="cli-dato-det"><%= sede.zona %></dd><% } %>
                  </div>
                <% } %>
                <% if (haConsegna) { %>
                  <div class="cli-dato">
                    <dt class="cli-dato-eti">Consegna abituale</dt>
                    <% if (consegna.via) { %><dd class="cli-dato-val"><%= consegna.via %></dd><% } %>
                    <% if (consegna.zona) { %><dd class="cli-dato-det"><%= consegna.zona %></dd><% } %>
                  </div>
                <% } %>
              </dl>
            <% } %>
          </section>
        <% } %>

        <% if (telefono || email) { %>
          <section class="cli-scheda" aria-labelledby="cli-contatti">
            <h2 class="cli-scheda-titolo" id="cli-contatti">Contatti</h2>
            <div class="cli-contatti">
              <% if (telefono) { %>
                <%# Il numero non è un collegamento (richiesta esplicita del 21/10/2026): un riquadro come gli altri, ma senza tocco né effetto al passaggio. %>
                <div class="cli-contatto cli-contatto-fisso">
                  <span class="cli-contatto-ico" aria-hidden="true"><%- iconaTelefono %></span>
                  <span class="cli-contatto-testi">
                    <span class="cli-dato-eti">Telefono</span>
                    <span class="cli-contatto-val cli-cifre"><%= telefono %></span>
                  </span>
                </div>
              <% } %>
              <% if (email) { %>
                <a class="cli-contatto" href="mailto:<%= email %>">
                  <span class="cli-contatto-ico" aria-hidden="true"><%- iconaEmail %></span>
                  <span class="cli-contatto-testi">
                    <span class="cli-dato-eti">Email</span>
                    <span class="cli-contatto-val"><%= email %></span>
                  </span>
                </a>
              <% } %>
            </div>
          </section>
        <% } %>

      </div>
      <% } %>

      <%# ---------- Destra: la decisione; per chi è già approvato, il materiale ordinato (a tutta larghezza) ---------- %>
      <div class="cli-colonna cli-colonna-destra<%= eApprovato ? ' cli-colonna-materiale' : '' %>">
        <% if (eDaVerificare) { %>
          <section class="cli-decisione" aria-labelledby="cli-titolo-decisione">
            <h2 id="cli-titolo-decisione">È un tuo cliente?</h2>
            <p>Se lo approvi potrà mandarti richieste e vedrà le condizioni che imposti.</p>
            <form method="POST" action="/distributore/clienti/<%= cliente.id %>/decidi">
              <label class="cli-campo-eti" for="codice_cliente">Codice cliente nel tuo gestionale <span>· facoltativo</span></label>
              <input class="cli-campo" type="text" id="codice_cliente" name="codice_cliente" placeholder="es. 004512"
                     maxlength="50" autocomplete="off">
              <label class="cli-campo-eti" for="note">Note interne <span>· le vedi solo tu</span></label>
              <textarea class="cli-campo" id="note" name="note" rows="3" maxlength="500"></textarea>
              <button class="cli-approva" type="submit" name="azione" value="approva">
                <%- iconaSpunta %>Sì, approva
              </button>
              <button class="cli-rifiuta" type="submit" name="azione" value="rifiuta"
                      onclick="return confirm('Rifiutare questa anagrafica? Il cliente non potrà inviarti richieste.')">
                <%- iconaChiudi %>Non lo riconosco: rifiuta
              </button>
            </form>
          </section>

        <% } else if (eRifiutato) { %>
          <section class="cli-decisione" aria-labelledby="cli-titolo-decisione">
            <h2 id="cli-titolo-decisione">Anagrafica non riconosciuta</h2>
            <p>Hai rifiutato questa anagrafica<% if (rapporto.note) { %>: <%= rapporto.note %><% } %>.</p>
            <form method="POST" action="/distributore/clienti/<%= cliente.id %>/decidi">
              <input type="hidden" name="codice_cliente" value="<%= rapporto.codice_cliente %>">
              <button class="cli-approva" type="submit" name="azione" value="approva">
                <%- iconaSpunta %>Ripensaci: approva l'anagrafica
              </button>
            </form>
          </section>

        <% } else { %>
          <%# Materiale ordinato: TUTTI gli ordini del cliente a questo banco, qualunque stato (src/materiale.js, materialeCliente). %>
          <%- include('partials/materiale_cliente', { m: materiale, clienteId: cliente.id, esporta: '/distributore/clienti/' + cliente.id + '/materiale.csv' }) %>
        <% } %>
      </div>
    </div>
  </main>

  <%- include('partials/nav_distributore', { attivo: 'clienti' }) %>
  <script src="<%= asset('/app.js') %>" defer></script>
</body>
</html>
