<%
  // Home del banco: bacheca a tre colonne (Da confermare -> Attesa corriere -> Da preparare). Il disegno dei tempi
  // (anello che si svuota, "Nuova", "da N min", minuti all'arrivo del corriere) parte da qui con i valori del server e
  // lo muove il blocco "Home del banco" di public/app.js, con le stesse soglie (data-soglia-* sulla bacheca).
  const RAGGIO = 25;
  const CIRCONFERENZA = Math.round(2 * Math.PI * RAGGIO * 100) / 100;
  const durata = (min) => (min < 60 ? min + ' min' : Math.floor(min / 60) + ' h ' + String(min % 60).padStart(2, '0'));
%>
<!DOCTYPE html>
<html lang="it">
<head>
  <%- include('partials/app_head', { titolo }) %>
</head>
<body class="pagina-banco" data-loggato="1" data-auto-refresh="15000" data-versione="<%= JSON.stringify(contatori) %>">

  <%# Intestazione unica del banco, la stessa di tutte le pagine del distributore (anche quelle che passano da appbar.ejs). %>
  <%- include('partials/banco_testa') %>

  <main class="bacheca" data-bacheca
        data-soglia-urgente="<%= bacheca.urgenteSec %>">

    <%# ---------- Da confermare ---------- %>
    <section class="colonna colonna-conferma" aria-labelledby="col-conferma">
      <div class="colonna-testa">
        <span class="colonna-icona" aria-hidden="true"><%- iconaTimer %></span>
        <h2 class="colonna-titolo" id="col-conferma">Da confermare</h2>
        <span class="colonna-conta" aria-label="<%= daConfermare.length %> richieste"><%= daConfermare.length %></span>
      </div>
      <div class="colonna-lista">
        <% if (!daConfermare.length) { %>
          <p class="colonna-vuota">Nessuna richiesta in attesa.</p>
        <% } %>
        <% daConfermare.forEach(function (r) { %>
          <article class="scheda scheda-richiesta<%= r.urgente ? ' urgente' : '' %><%= r.appena ? ' entra' : '' %>"
                   data-richiesta data-secondi="<%= r.secondi %>" data-finestra="<%= finestraSecondi %>"
                   data-nuova-sec="<%= r.nuovaSec %>">
            <div class="scheda-testa">
              <div class="anello">
                <svg viewBox="0 0 56 56" aria-hidden="true">
                  <circle class="anello-traccia" cx="28" cy="28" r="<%= RAGGIO %>"/>
                  <circle class="anello-barra" data-anello cx="28" cy="28" r="<%= RAGGIO %>"
                          transform="rotate(-90 28 28)"
                          stroke-dasharray="<%= CIRCONFERENZA %>"
                          style="stroke-dashoffset: <%= (CIRCONFERENZA * (1 - r.frazione)).toFixed(2) %>"/>
                </svg>
                <span class="anello-tempo" data-tempo><%= fmt.mmss(r.secondi) %></span>
              </div>
              <div class="scheda-testi">
                <div class="scheda-nome-riga">
                  <h3 class="scheda-nome"><%= r.cliente_nome %></h3>
                  <% if (r.nuovaSec > 0) { %><span class="etichetta-nuova" data-nuova>Nuova</span><% } %>
                </div>
                <div class="scheda-sotto">
                  <%= r.nArticoli %> <%= r.nArticoli === 1 ? 'articolo' : 'articoli' %> · <%= r.nPezzi %> <%= r.nPezzi === 1 ? 'pezzo' : 'pezzi' %>
                </div>
              </div>
            </div>

            <%- include('partials/banco_articoli', { articoli: r.anteprima, altre: r.altre }) %>

            <%# "Conferma" conferma subito tutto il materiale, senza aprire il dettaglio (se non riesce, il server riporta al dettaglio
                con l'errore). "Ispeziona" apre il dettaglio per controllare prima; "Non disponibile" rifiuta subito. %>
            <div class="scheda-azioni">
              <form class="scheda-azione-conferma" method="POST" action="/distributore/richieste/<%= r.id %>/rispondi">
                <input type="hidden" name="azione" value="prezzo_richiesto">
                <input type="hidden" name="torna" value="home">
                <button class="btn-banco btn-banco-conferma btn-banco-medio" type="submit">Conferma</button>
              </form>
              <div class="scheda-azioni-secondarie">
                <a class="btn-banco btn-banco-secondario btn-banco-piccolo" href="/distributore/richieste/<%= r.id %>"><%- iconaOcchio %>Ispeziona</a>
                <form method="POST" action="/distributore/richieste/<%= r.id %>/rispondi">
                  <input type="hidden" name="azione" value="rifiuta">
                  <input type="hidden" name="torna" value="home">
                  <button class="btn-banco btn-banco-secondario btn-banco-piccolo" type="submit">Non disponibile</button>
                </form>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
    </section>

    <%# ---------- Attesa corriere ---------- %>
    <section class="colonna colonna-corriere" aria-labelledby="col-corriere">
      <div class="colonna-testa">
        <span class="colonna-icona" aria-hidden="true"><%- iconaMessaggio %></span>
        <h2 class="colonna-titolo" id="col-corriere">Attesa corriere</h2>
        <span class="colonna-conta" aria-label="<%= attesaCorriere.length %> richieste"><%= attesaCorriere.length %></span>
      </div>
      <div class="colonna-lista">
        <% if (!attesaCorriere.length) { %>
          <p class="colonna-vuota">Nessuna consegna in attesa di un corriere.</p>
        <% } %>
        <% attesaCorriere.forEach(function (c) { %>
          <article class="scheda scheda-corriere" data-corriere data-trascorsi="<%= c.trascorsi %>">
            <div class="scheda-testa scheda-testa-corriere">
              <span class="scheda-icona" aria-hidden="true"><%- iconaMessaggio %></span>
              <div class="scheda-testi">
                <h3 class="scheda-nome"><%= c.cliente_nome %></h3>
                <div class="stato-corriere">
                  Corriere avvisato · da <span data-da><%= fmt.daMinuti(c.trascorsi) %></span>
                </div>
              </div>
              <a class="btn-ispeziona" href="/distributore/richieste/<%= c.id %>" aria-label="Ispeziona la richiesta di <%= c.cliente_nome %>"><%- iconaOcchio %>Ispeziona</a>
            </div>

            <%- include('partials/banco_articoli', { articoli: c.anteprima, altre: c.altre }) %>

            <p class="scheda-nota">Confermato da te. Non preparare ancora: aspetta che un corriere prenda la consegna.</p>
          </article>
        <% }); %>
      </div>
    </section>

    <%# ---------- Da preparare ---------- %>
    <section class="colonna colonna-preparare" aria-labelledby="col-preparare">
      <div class="colonna-testa">
        <span class="colonna-icona" aria-hidden="true"><%- iconaOrdini %></span>
        <h2 class="colonna-titolo" id="col-preparare">Da preparare</h2>
        <span class="colonna-conta" aria-label="<%= daPreparare.length %> ordini"><%= daPreparare.length %></span>
      </div>
      <div class="colonna-lista">
        <% if (!daPreparare.length) { %>
          <p class="colonna-vuota">Nessun ordine da preparare.</p>
        <% } %>
        <% daPreparare.forEach(function (o) {
             const minutiArrivo = o.arrivo ? Math.ceil(o.arrivo.secondi / 60) : 0;
             const inRitardo = o.arrivo && minutiArrivo <= 0;
        %>
          <article class="scheda scheda-ordine">
            <div class="scheda-testa scheda-testa-alto">
              <div class="scheda-testi">
                <h3 class="scheda-nome"><%= o.cliente_nome %></h3>
                <div class="scheda-sotto">
                  Ordine #<%= o.id %><% if (o.arrivo) { %> · ritira <%= o.corriere_nome || 'il corriere' %><% } %>
                </div>
              </div>
              <%# Solo i minuti che mancano al ritiro, sempre in verde (richiesta esplicita del 21/10/2026: niente orario "ore HH:MM", niente rosso negli ultimi minuti). %>
              <% if (o.arrivo) { %>
                <div class="pillola-arrivo" data-arrivo data-secondi="<%= o.arrivo.secondi %>">
                  <span class="pillola-min" data-arrivo-min><%= inRitardo ? 'In ritardo' : durata(minutiArrivo) %></span>
                </div>
              <% } %>
            </div>

            <%- include('partials/banco_articoli', { articoli: o.anteprima, altre: o.altre }) %>

            <%# "Ispeziona" apre la pagina dell'ordine (non lo tocca: resta in colonna).
                "Preparato" lo toglie da qui: lo porta "In consegna" e avvisa il cliente (POST .../preparazione, torna alla home). %>
            <div class="scheda-azioni">
              <div class="scheda-azioni-ordine">
                <a class="btn-banco btn-banco-secondario btn-banco-piccolo" href="/distributore/ordini/<%= o.id %>"><%- iconaOcchio %>Ispeziona</a>
                <form method="POST" action="/distributore/ordini/<%= o.id %>/preparazione">
                  <input type="hidden" name="torna" value="home">
                  <button class="btn-banco btn-banco-prepara btn-banco-piccolo" type="submit"><%- iconaSpunta %>Preparato</button>
                </form>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
    </section>
  </main>

  <%- include('partials/nav_distributore', { attivo: 'home', contatori }) %>
  <script src="<%= asset('/app.js') %>" defer></script>
</body>
</html>
